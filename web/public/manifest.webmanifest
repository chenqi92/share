{
  "name": "MeshDrop · LAN sharing",
  "short_name": "MeshDrop",
  "description": "局域网设备发现 + 端到端加密文件传输 · 浏览器即用，无需安装",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0E0C09",
  "theme_color": "#0E0C09",
  "lang": "zh-CN",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
