# 通用
.DS_Store
*.swp
*.bak
*.log
# conformance 证据目录里的 send.log / recv.log 必须入库（见 protocol/conformance-tests.md §一·证据采集）
!**/screenshots/conformance/**/*.log
# C4 等大文件用例的临时 4 GiB 测试文件不入库
**/screenshots/conformance/**/bigfile.bin

# 设计源稿（jsx 预览 / 截图）— 本地保留，不入库
design/shar/
# 但 logo 源 PNG 入库，给 iconforge 用
!design/logo-light.png
!design/logo-dark.png

# Apple / Xcode
# xcodeproj 由 xcodegen 从 project.yml 生成，不入库（避免机器路径污染 diff）
xcuserdata/
*.xcodeproj/
*.xcworkspace/xcuserdata/
DerivedData/
build/
build-ios/
.build/
.swiftpm/
Package.resolved

# Android
# 上架签名与密码：绝不入库（丢失/泄露都会很麻烦）
*.jks
*.keystore
android/key.properties
# 备案特征值（含密码/签名）：本地保留，勿入库
备案信息.md
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
# gradle-wrapper.jar 在 global ~/.gitignore_global 的 *.jar 通配中会被忽略；
# 这是 gradlew 启动必须的二进制（gradle wrapper 标准结构），显式 unignore
!android/gradle/wrapper/gradle-wrapper.jar

# Wear OS
wearos/.gradle/
wearos/.kotlin/
wearos/build/
wearos/app/build/
wearos/local.properties
wearos/captures/
wearos/.idea/
*.iml
*.apk
*.aab

# Windows / .NET
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
*.nupkg
packages/
artifacts/

# Linux / Rust
linux/target/
linux/Cargo.lock

# IDE
.idea/
.vscode/
!.vscode/settings.json
*.iml

# 本地协调文件（不入库）
CONTROL-ROADMAP.md
.claude/
screenshots
_appstore_screenshots
