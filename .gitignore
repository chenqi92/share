# 通用
.DS_Store
*.swp
*.bak
*.log

# 设计源稿（jsx 预览 / 截图）— 本地保留，不入库
design/shar/
# 但 logo 源 PNG 入库，给 iconforge 用
!design/logo-light.png
!design/logo-dark.png

# Apple / Xcode
# xcodeproj 由 xcodegen 从 project.yml 生成，不入库（避免机器路径污染 diff）
xcuserdata/
*.xcodeproj/
*.xcworkspace/xcuserdata/
DerivedData/
build/
.build/
.swiftpm/
Package.resolved

# Android
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
# gradle-wrapper.jar 在 global ~/.gitignore_global 的 *.jar 通配中会被忽略；
# 这是 gradlew 启动必须的二进制（gradle wrapper 标准结构），显式 unignore
!android/gradle/wrapper/gradle-wrapper.jar

