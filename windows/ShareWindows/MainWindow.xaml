<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeshDrop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MeshDrop.Models"
    xmlns:vm="using:MeshDrop.ViewModels">

    <Grid>
        <!-- 渐变背景 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D6E9FF" Offset="0"/>
                <GradientStop Color="#E8DFFF" Offset="0.5"/>
                <GradientStop Color="#FFE1EA" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部本机卡片 -->
        <Border Grid.Row="0" Margin="16,16,16,8"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Padding="20" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 头像 -->
                <Border Grid.Column="0" CornerRadius="28" Width="56" Height="56">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#A855F7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE701;" Foreground="White" FontSize="24"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.DisplayName}"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <Border CornerRadius="10" Background="#3B82F6"
                                VerticalAlignment="Center">
                            <TextBlock Text="本机" Foreground="White" FontSize="11"
                                       FontWeight="SemiBold" Margin="8,2,8,2"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" Opacity="0.7" FontFamily="Cascadia Mono">
                            <Run Text="正在广播 · 指纹"/>
                            <Run Text="{x:Bind ViewModel.FingerprintShort}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind ViewModel.Engine.Devices.Count, Mode=OneWay}"
                               FontSize="32" FontWeight="Bold" Foreground="#3B82F6"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="可见设备" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 设备列表 -->
        <ScrollViewer Grid.Row="1" Padding="16,8,16,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="附近设备" FontSize="16" FontWeight="SemiBold"/>
                    <Border CornerRadius="10" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                        <TextBlock Text="{x:Bind ViewModel.Engine.Devices.Count, Mode=OneWay}"
                                   FontSize="11" Opacity="0.8" Margin="8,2,8,2"/>
                    </Border>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Engine.Devices, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Device">
                            <Border CornerRadius="18" Padding="14"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    Tapped="DeviceCard_Tapped">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="14" Width="48" Height="48"
                                            Background="#3B82F6">
                                        <FontIcon Glyph="&#xE770;" Foreground="White" FontSize="22"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                        <TextBlock Opacity="0.65" FontSize="12">
                                            <Run Text="{x:Bind Os}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{x:Bind Model}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Opacity="0.5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border CornerRadius="18" Padding="40"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        Visibility="{x:Bind EmptyVisibility(ViewModel.Engine.Devices.Count), Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="40" Opacity="0.5"/>
                        <TextBlock Text="正在搜索附近设备…" HorizontalAlignment="Center"/>
                        <TextBlock Text="确保对方设备在同一 Wi-Fi 或局域网下，并已启动 MeshDrop"
                                   FontSize="11" Opacity="0.55" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 历史区 -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorAltBrush}"
                MaxHeight="260"
                Visibility="{x:Bind HistoryVisibility(ViewModel.Engine.History.Count), Mode=OneWay}">
            <Grid Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE823;" Foreground="#3B82F6"/>
                    <TextBlock Text="历史" FontWeight="SemiBold"/>
                    <Border CornerRadius="10" Background="#3B82F61A">
                        <TextBlock Text="{x:Bind ViewModel.Engine.History.Count, Mode=OneWay}"
                                   FontSize="11" Foreground="#3B82F6" Margin="8,2,8,2"/>
                    </Border>
                    <Button Click="ClearHistory_Click" Style="{StaticResource TextBlockButtonStyle}"
                            HorizontalAlignment="Right">
                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Engine.History, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryItem">
                                <Border CornerRadius="10" Padding="10"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74A;" FontSize="11"
                                                      Foreground="{x:Bind DirectionColor(Direction)}"/>
                                            <TextBlock Text="{x:Bind DirectionLabel(Direction)}"
                                                       FontSize="11" Opacity="0.65"/>
                                            <TextBlock Text="{x:Bind Peer.Name}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind FormattedTime}" FontSize="11" Opacity="0.5"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ContentSummary(Kind)}" TextWrapping="Wrap" MaxLines="3"/>
                                        <TextBlock Text="{x:Bind StatusLabel(Status)}" FontSize="11"
                                                   Foreground="{x:Bind StatusColor(Status)}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
