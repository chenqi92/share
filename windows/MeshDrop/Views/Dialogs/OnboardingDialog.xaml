<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MeshDrop.Views.Dialogs.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    Title=""
    DefaultButton="Primary"
    Background="{ThemeResource MdCardBrush}"
    Width="600">

    <Grid MinWidth="540" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
            <ctrl:MeshDropLogo Size="34"/>
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="meshdrop"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="SemiBold"
                           FontSize="26"
                           CharacterSpacing="-25"
                           Foreground="{ThemeResource MdInkBrush}"/>
                <Ellipse Width="8" Height="8" Fill="{ThemeResource MdLimeBrush}"
                         VerticalAlignment="Bottom" Margin="2,0,0,5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock x:Uid="onboarding/headline1"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="Bold"
                       FontSize="24"/>
            <TextBlock x:Uid="onboarding/headline2"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="Bold"
                       FontSize="24"
                       Foreground="{ThemeResource MdLimeDeepBrush}"/>
            <TextBlock x:Uid="onboarding/tagline"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="11"
                       Opacity="0.6"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="onboarding/step1Tag" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock x:Uid="onboarding/step1Title"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Uid="onboarding/step1Hint"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="onboarding/step2Tag" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock x:Uid="onboarding/step2Title"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Uid="onboarding/step2Hint"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="onboarding/step3Tag" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock x:Uid="onboarding/step3Title"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Uid="onboarding/step3Hint"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="onboarding/step4Tag" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock x:Uid="onboarding/step4Title"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Uid="onboarding/step4Hint"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
