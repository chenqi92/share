<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MeshDrop.Views.Dialogs.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    Title=""
    CloseButtonText="跳过"
    PrimaryButtonText="开始使用 →"
    DefaultButton="Primary"
    Background="{ThemeResource MdCardBrush}"
    Width="600">

    <Grid MinWidth="540" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
            <ctrl:MeshDropLogo Size="34"/>
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="meshdrop"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="SemiBold"
                           FontSize="26"
                           CharacterSpacing="-25"
                           Foreground="{ThemeResource MdInkBrush}"/>
                <Ellipse Width="8" Height="8" Fill="{ThemeResource MdLimeBrush}"
                         VerticalAlignment="Bottom" Margin="2,0,0,5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="一个内网，任何设备，"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="Bold"
                       FontSize="24"/>
            <TextBlock Text="谁都能 ping 到。"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="Bold"
                       FontSize="24"
                       Foreground="{ThemeResource MdLimeDeepBrush}"/>
            <TextBlock Text="An intranet drop · radar discovery · drag-to-send · E2E encryption"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="11"
                       Opacity="0.6"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="01 · 发现" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock Text="同 Wi-Fi 即互见"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="雷达式扫描，4.5s/圈 · 周期呼吸"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="02 · 拖即发" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock Text="文件直接拖到设备"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="不需要打开聊天页"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="03 · E2E" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock Text="不经过任何云端"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="X25519 + ChaCha20-Poly1305"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" CornerRadius="10" Background="{ThemeResource MdPaper2Brush}" Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="04 · 托盘" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock Text="始终在任务栏"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="WIN+S 一键唤出"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10" Opacity="0.6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
