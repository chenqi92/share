<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MeshDrop.Views.Dialogs.SendDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    Title=""
    CloseButtonText="取消"
    PrimaryButtonText="发送 →"
    DefaultButton="Primary"
    Background="{ThemeResource MdCardBrush}"
    Width="540">

    <StackPanel Spacing="14" MinWidth="480">
        <!-- Header：目标设备 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ctrl:AvatarControl Grid.Column="0" Size="42" Initials="LL" ColorHex="#FFB4A1" ShowRing="Visible"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                <TextBlock Text="发送到 · 李莉"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           CharacterSpacing="-25"/>
                <TextBlock Text="Lily's MacBook · macOS 15.3 · 18 ms"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="10"
                           Opacity="0.6"/>
            </StackPanel>
            <ctrl:ChipControl Grid.Column="2" Text="E2E" Tone="Lime" Mono="True" VerticalAlignment="Center"/>
        </Grid>

        <ctrl:AsciiDivider Label="── KIND · 类型 ──"/>

        <SelectorBar x:Name="Modes">
            <SelectorBarItem Text="文本 · Text" Tag="text" IsSelected="True"/>
            <SelectorBarItem Text="文件 · File" Tag="file"/>
            <SelectorBarItem Text="文字便签 · Note" Tag="note"/>
        </SelectorBar>

        <StackPanel x:Name="TextPanel" Spacing="6">
            <TextBox PlaceholderText="说点什么…"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="160"
                     FontFamily="{StaticResource MdBodyFontFamily}"
                     FontSize="13"
                     Background="{ThemeResource MdPaperBrush}"
                     BorderBrush="{ThemeResource MdLineBrush}"
                     CornerRadius="8"/>
            <TextBlock Text="按 Ctrl+Enter 立即发送 · ESC 关闭"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="10"
                       Opacity="0.45"/>
        </StackPanel>

        <Border CornerRadius="8"
                Background="{ThemeResource MdLimeFaintBrush}"
                BorderBrush="{ThemeResource MdLimeBrush}"
                BorderThickness="1"
                Padding="10,8,10,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="✓" Foreground="{ThemeResource MdLimeDeepBrush}" FontWeight="Bold"/>
                <TextBlock Text="该消息将经 X25519 + ChaCha20-Poly1305 端到端加密后直连 192.168.1.31"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="10"
                           Opacity="0.75"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
