<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MeshDrop.Views.Dialogs.SendDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    Title=""
    DefaultButton="Primary"
    Background="{ThemeResource MdCardBrush}"
    Width="540">

    <StackPanel Spacing="14" MinWidth="480">
        <!-- Header：目标设备 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ctrl:AvatarControl Grid.Column="0" Size="42" Initials="LL" ColorHex="#FFB4A1" ShowRing="Visible"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                <TextBlock x:Uid="send/toFormat"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           CharacterSpacing="-25"/>
                <TextBlock Text="Lily's MacBook · macOS 15.3 · 18 ms"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="10"
                           Opacity="0.6"/>
            </StackPanel>
            <ctrl:ChipControl Grid.Column="2" x:Name="PlaintextChip" Tone="Outline" Mono="True" VerticalAlignment="Center"/>
        </Grid>

        <ctrl:AsciiDivider x:Name="KindDivider"/>

        <SelectorBar x:Name="Modes">
            <SelectorBarItem x:Uid="send/kindText" Tag="text" IsSelected="True"/>
            <SelectorBarItem x:Uid="send/kindFile" Tag="file"/>
            <SelectorBarItem x:Uid="send/kindNote" Tag="note"/>
        </SelectorBar>

        <StackPanel x:Name="TextPanel" Spacing="6">
            <TextBox x:Uid="send/editor"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="160"
                     FontFamily="{StaticResource MdBodyFontFamily}"
                     FontSize="13"
                     Background="{ThemeResource MdPaperBrush}"
                     BorderBrush="{ThemeResource MdLineBrush}"
                     CornerRadius="8"/>
            <TextBlock x:Uid="send/shortcutHint"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="10"
                       Opacity="0.45"/>
        </StackPanel>

        <Border CornerRadius="8"
                Background="{ThemeResource MdLimeFaintBrush}"
                BorderBrush="{ThemeResource MdLimeBrush}"
                BorderThickness="1"
                Padding="10,8,10,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                <TextBlock x:Uid="send/securityNote"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="10"
                           Opacity="0.75"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
