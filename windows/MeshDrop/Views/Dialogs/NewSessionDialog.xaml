<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MeshDrop.Views.Dialogs.NewSessionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    xmlns:mock="using:MeshDrop.Mock"
    Title=""
    DefaultButton="Primary"
    Background="{ThemeResource MdCardBrush}"
    Width="480">

    <Grid MinWidth="420" MinHeight="140">
        <!-- 设备列表：从引擎实时设备投影，单选 -->
        <ListView x:Name="DeviceList"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  MaxHeight="360">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="mock:MockDevice">
                    <Grid ColumnSpacing="12" Padding="2,8,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ctrl:AvatarControl Grid.Column="0" Size="38"
                                            Initials="{x:Bind Initials}"
                                            ColorHex="{x:Bind ColorHex}"
                                            ShowRing="Collapsed"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                            <TextBlock Text="{x:Bind Name}"
                                       FontFamily="{StaticResource MdDisplayFontFamily}"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                            <TextBlock Text="{x:Bind Os}"
                                       FontFamily="{StaticResource MdMonoFontFamily}"
                                       FontSize="10"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空态：附近无设备 -->
        <StackPanel x:Name="EmptyPanel"
                    Visibility="Collapsed"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="0,24,0,24">
            <TextBlock Text="&#x25CC;"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontSize="34"
                       Opacity="0.55"/>
            <TextBlock x:Name="EmptyTitle"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="SemiBold"
                       FontSize="14"/>
            <TextBlock x:Name="EmptyHint"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="11"
                       Opacity="0.6"/>
        </StackPanel>
    </Grid>
</ContentDialog>
