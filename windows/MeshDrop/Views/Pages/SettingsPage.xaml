<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls">

    <Grid Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,18,24,10" Spacing="4">
            <TextBlock Text="设置 · Settings"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="Bold"
                       FontSize="28"
                       CharacterSpacing="-25"/>
            <TextBlock Text="本机偏好 · 仅保存在本机"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="11"
                       Opacity="0.65"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,4,24,18">
            <StackPanel Spacing="22" MaxWidth="720" HorizontalAlignment="Left">

                <!-- 可见性 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="可见性 · VISIBILITY"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="谁能在 Nearby 看见你"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="设备名 · Display name" FontWeight="SemiBold" FontSize="12"/>
                                <TextBox Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                                         Background="{ThemeResource MdPaperBrush}"
                                         BorderBrush="{ThemeResource MdLineBrush}"
                                         CornerRadius="6"
                                         FontFamily="{StaticResource MdBodyFontFamily}"/>
                            </StackPanel>
                            <!-- 可见性与空闲隐藏尚未接 mDNS 广告开关，禁用并标注。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Visible, Mode=TwoWay}" IsEnabled="False"
                                          Header="对 LAN 可见 · 即将支持"
                                          OffContent="OFF · 仅自己看到"
                                          OnContent="ON · LAN 内全部"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.HideAfterIdle, Mode=TwoWay}" IsEnabled="False"
                                          Header="空闲 10 分钟后自动隐藏 · 即将支持"
                                          OffContent="OFF"
                                          OnContent="ON"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 安全/加密 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="安全 · SECURITY"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="Ed25519 身份 · SHA-256 指纹 · LAN 明文 v0.1"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="10"
                                   Opacity="0.55"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="本机指纹 · Fingerprint" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Fingerprint}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource MdLimeBrush}"/>
                                </Border>
                            </StackPanel>
                            <!-- 诚实状态：v0.1 LAN 为明文 TCP（README 阶段取舍），不谎称 E2E。 -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="传输安全 · TRANSPORT" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="LAN · 明文 TCP · v0.1。身份与配对由 Ed25519 + SHA-256 指纹保护。"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="10" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- TOFU 首次配对始终需双向确认指纹，不可关闭 → 锁定 ON 的只读状态。 -->
                            <ToggleSwitch IsOn="True" IsEnabled="False"
                                          Header="首次配对需确认指纹 · TOFU"
                                          OnContent="ON · 始终启用"
                                          OffContent="OFF"/>
                            <Button x:Name="ResetIdentityButton"
                                    Content="重置身份…"
                                    Click="OnResetIdentityClick"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Background="{ThemeResource MdFlameBrush}"
                                    Foreground="{ThemeResource MdPaperBrush}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 行为/接收 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="行为 · BEHAVIOR"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="接收路径、声音、开机自启"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="接收文件夹 · 按对端分子目录" FontWeight="SemiBold" FontSize="12"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 当前固定保存到 Documents/MeshDrop/<对端>，仅展示路径。自定义目录即将支持。 -->
                                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.ReceiveDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="{ThemeResource MdPaperBrush}"
                                             BorderBrush="{ThemeResource MdLineBrush}"
                                             CornerRadius="6"
                                             FontFamily="{StaticResource MdMonoFontFamily}"/>
                                    <Button Grid.Column="1" Style="{StaticResource MdOutlineButtonStyle}" IsEnabled="False">
                                        <TextBlock Text="浏览…"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <!-- 已接线：自动接收来自已配对设备的文件（engine.AutoAcceptFromTrusted）。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoAcceptTrusted, Mode=TwoWay}"
                                          Header="自动接收已配对设备"
                                          OnContent="ON · 已配对设备不再弹窗" OffContent="OFF · 每次确认"/>
                            <!-- 以下为尚未接线的占位项，禁用并标注，避免给出虚假预期。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoAccept, Mode=TwoWay}" IsEnabled="False"
                                          Header="自动接收任何文件 · 即将支持"
                                          OnContent="ON" OffContent="OFF · 每次确认"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.RingOnIncoming, Mode=TwoWay}" IsEnabled="False"
                                          Header="接收时发声 · 即将支持"
                                          OnContent="ON" OffContent="OFF"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}" IsEnabled="False"
                                          Header="开机自启动到托盘 · 即将支持"
                                          OnContent="ON" OffContent="OFF"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTrayBadge, Mode=TwoWay}" IsEnabled="False"
                                          Header="任务栏图标显示活跃数 · 即将支持"
                                          OnContent="ON" OffContent="OFF"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Web 访问 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Web 访问 · WEB ACCESS"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="浏览器走 LAN 网关访问"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.WebGatewayEnabled, Mode=TwoWay}"
                                          Header="启用 Web Gateway"
                                          OnContent="ON · LAN 浏览器可连"
                                          OffContent="OFF"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="访问地址 · URL" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayUrl, Mode=OneWay}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource MdLimeBrush}"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="配对码 · 24 小时有效" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayPairingCode, Mode=OneWay}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="14"
                                               Foreground="{ThemeResource MdLimeBrush}"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="首次访问会弹证书提示，请在浏览器接受 meshdrop.local 自签证书。"
                                       FontFamily="{StaticResource MdMonoFontFamily}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- About -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="关于 · ABOUT"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="version" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ip" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Ip}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="device" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DeviceModel}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
