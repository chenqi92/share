<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource MdCardBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource MdLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style x:Key="SettingDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Background" Value="{ThemeResource MdLineBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{ThemeResource MdPaperBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" Padding="28,24,28,32">
            <StackPanel Spacing="28" MaxWidth="840" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="settings/title" FontSize="28" FontWeight="Bold"
                               FontFamily="{StaticResource MdDisplayFontFamily}"/>
                    <TextBlock x:Uid="settings/subtitle" FontSize="13"
                               Foreground="{ThemeResource MdInk60Brush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Uid="settings/visibilityTag" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingsSection}">
                        <StackPanel>
                            <StackPanel Padding="20,18" Spacing="8">
                                <TextBlock x:Name="DeviceNameLabel" x:Uid="settings/displayName" FontSize="14" FontWeight="SemiBold"/>
                                <TextBox Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                                         MaxWidth="400" HorizontalAlignment="Stretch" MinHeight="36"
                                         CornerRadius="6" AutomationProperties.LabeledBy="DeviceNameLabel"/>
                                <TextBlock x:Uid="settings/visibilityHint" FontSize="12"
                                           Foreground="{ThemeResource MdInk60Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Style="{StaticResource SettingDivider}"/>
                            <ctrl:SettingsToggleRow x:Uid="settings/visibleRow" IsOn="{x:Bind ViewModel.Visible, Mode=TwoWay}"/>
                            <Border Style="{StaticResource SettingDivider}"/>
                            <ctrl:SettingsToggleRow x:Uid="settings/trustedOnlyRow" IsOn="{x:Bind ViewModel.TrustedOnly, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Uid="settings/receiveTitle" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingsSection}">
                        <StackPanel>
                            <ctrl:SettingsToggleRow x:Uid="settings/autoAcceptRow" IsOn="{x:Bind ViewModel.AutoAcceptTrusted, Mode=TwoWay}"/>
                            <Border Style="{StaticResource SettingDivider}"/>
                            <Grid Padding="20,16" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Uid="settings/receiveDir" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.ReceiveDir}" IsTextSelectionEnabled="True"
                                               FontSize="12" Foreground="{ThemeResource MdInk60Brush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Uid="settings/openFolder" Click="OnOpenReceiveFolder"
                                        Style="{StaticResource MdOutlineButtonStyle}" VerticalAlignment="Center" MinHeight="36"/>
                            </Grid>
                            <Border Style="{StaticResource SettingDivider}"/>
                            <ctrl:SettingsToggleRow x:Uid="settings/clipboardRow" IsOn="{x:Bind ViewModel.ClipboardSync, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Uid="settings/systemTitle" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingsSection}">
                        <StackPanel>
                            <ctrl:SettingsToggleRow x:Uid="settings/startupRow" IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}"/>
                            <Border Style="{StaticResource SettingDivider}"/>
                            <ctrl:SettingsToggleRow x:Uid="settings/trayRow" IsOn="{x:Bind ViewModel.ShowTrayBadge, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Uid="settings/webAccessTag" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingsSection}">
                        <StackPanel>
                            <ctrl:SettingsToggleRow x:Uid="settings/webRow" IsOn="{x:Bind ViewModel.WebGatewayEnabled, Mode=TwoWay}"/>
                            <Border Style="{StaticResource SettingDivider}"/>
                            <StackPanel Padding="20,16" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="settings/webUrlLabel" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayUrl, Mode=OneWay}" FontSize="14"
                                               IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="settings/pairingCodeLabel" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayPairingCode, Mode=OneWay}" FontSize="22"
                                               FontWeight="SemiBold" FontFamily="{StaticResource MdMonoFontFamily}"
                                               IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Uid="settings/certHint" FontSize="12"
                                           Foreground="{ThemeResource MdInk60Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Uid="settings/securityTag" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingsSection}">
                        <StackPanel>
                            <StackPanel Padding="20,18" Spacing="10">
                                <TextBlock x:Uid="settings/transportLabel" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Uid="settings/transportHint" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource MdInk60Brush}"/>
                                <TextBlock x:Uid="settings/fingerprintLabel" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                                <TextBlock Text="{x:Bind ViewModel.Fingerprint}" FontSize="13" TextWrapping="Wrap"
                                           FontFamily="{StaticResource MdMonoFontFamily}" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                            <Border Style="{StaticResource SettingDivider}"/>
                            <Button x:Name="ResetIdentityButton" x:Uid="settings/resetIdentity" Click="OnResetIdentityClick"
                                    Style="{StaticResource MdOutlineButtonStyle}" Foreground="{ThemeResource MdErrorBrush}"
                                    HorizontalAlignment="Left" Margin="20,16" MinHeight="36"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Uid="settings/aboutTag" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingsSection}" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Image Source="ms-appx:///Assets/AppIcon.png" Width="48" Height="48"/>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="MeshDrop" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind ViewModel.AppVersion}" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Uid="settings/aboutScope" TextWrapping="Wrap" FontSize="14"/>
                            <TextBlock x:Uid="settings/aboutCompatibility" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                            <StackPanel>
                                <HyperlinkButton x:Uid="settings/appleStoreLink" NavigateUri="https://apps.apple.com/app/meshdrop/id6772689903" HorizontalAlignment="Left" Padding="0,8"/>
                                <HyperlinkButton x:Uid="settings/releasesLink" NavigateUri="https://github.com/chenqi92/share/releases" HorizontalAlignment="Left" Padding="0,8"/>
                                <HyperlinkButton x:Uid="settings/sourceLink" NavigateUri="https://github.com/chenqi92/share" HorizontalAlignment="Left" Padding="0,8"/>
                                <HyperlinkButton x:Uid="settings/websiteLink" NavigateUri="https://kkape.com/tools/share" HorizontalAlignment="Left" Padding="0,8"/>
                                <HyperlinkButton x:Uid="settings/privacyLink" NavigateUri="https://kkape.com/privacy/share/" HorizontalAlignment="Left" Padding="0,8"/>
                            </StackPanel>
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Uid="settings/deviceLabel" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DeviceModel}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" x:Uid="settings/ipLabel" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Ip, Mode=OneWay}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="© 2026 chenqi92 · MIT" FontSize="12" Foreground="{ThemeResource MdInk60Brush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
