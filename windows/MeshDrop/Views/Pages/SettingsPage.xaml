<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls">

    <Grid Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,18,24,10" Spacing="4">
            <TextBlock x:Uid="settings/title"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="Bold"
                       FontSize="28"
                       CharacterSpacing="-25"/>
            <TextBlock x:Uid="settings/subtitle"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="11"
                       Opacity="0.65"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,4,24,18">
            <StackPanel Spacing="22" MaxWidth="720" HorizontalAlignment="Left">

                <!-- 可见性 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="settings/visibilityTag"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock x:Uid="settings/visibilityHint"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="settings/displayName" FontWeight="SemiBold" FontSize="12"/>
                                <TextBox Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                                         Background="{ThemeResource MdPaperBrush}"
                                         BorderBrush="{ThemeResource MdLineBrush}"
                                         CornerRadius="6"
                                         FontFamily="{StaticResource MdBodyFontFamily}"/>
                            </StackPanel>
                            <!-- 局域网可见：真开关，停/启 mDNS 广告（引擎复用现有 listener）。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Visible, Mode=TwoWay}"
                                          x:Uid="settings/visibleToggle"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 安全/加密 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="settings/securityTag"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock x:Uid="settings/securityHint"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="10"
                                   Opacity="0.55"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="settings/fingerprintLabel" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Fingerprint}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource MdLimeBrush}"/>
                                </Border>
                            </StackPanel>
                            <!-- 诚实状态：v0.1 LAN 为明文 TCP（README 阶段取舍），不谎称 E2E。 -->
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="settings/transportLabel" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Uid="settings/transportHint"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="10" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- TOFU 首次配对始终需双向确认指纹，不可关闭 → 锁定 ON 的只读状态。
                                 关闭语义危险（自动信任陌生设备），故保持开 + 锁定。 -->
                            <ToggleSwitch IsOn="True" IsEnabled="False"
                                          x:Uid="settings/tofuToggle"
                                          OffContent="OFF"/>
                            <!-- 仅显示已配对设备：开=未知 fp 直接关连接，不弹配对。默认关。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.TrustedOnly, Mode=TwoWay}"
                                          x:Uid="settings/trustedOnlyToggle"
                                          OnContent="ON" OffContent="OFF"/>
                            <!-- 接收前必须验证对方指纹：开=禁用一切自动接受，offer 一律待确认。默认开。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.VerifyBeforeReceive, Mode=TwoWay}"
                                          x:Uid="settings/verifyReceiveToggle"
                                          OnContent="ON" OffContent="OFF"/>
                            <!-- 危险动作：基于项目统一的 MdAccentButtonStyle 派生 flame 实底，
                                 不再用内置 AccentButtonStyle（其 hover/press 会落回 lime accent）。 -->
                            <Button x:Name="ResetIdentityButton"
                                    x:Uid="settings/resetIdentity"
                                    Click="OnResetIdentityClick"
                                    Style="{StaticResource MdAccentButtonStyle}"
                                    Background="{ThemeResource MdFlameBrush}"
                                    Foreground="{ThemeResource MdPaperBrush}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 行为/接收 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="settings/behaviorTag"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock x:Uid="settings/behaviorHint"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="settings/receiveDir" FontWeight="SemiBold" FontSize="12"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 当前固定保存到 Documents/MeshDrop/<对端>，仅展示路径。自定义目录即将支持。 -->
                                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.ReceiveDir, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="{ThemeResource MdPaperBrush}"
                                             BorderBrush="{ThemeResource MdLineBrush}"
                                             CornerRadius="6"
                                             FontFamily="{StaticResource MdMonoFontFamily}"/>
                                    <Button Grid.Column="1" Style="{StaticResource MdOutlineButtonStyle}" IsEnabled="False">
                                        <TextBlock x:Uid="settings/browse"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <!-- 自动接收来自已配对设备的文件（受「接收前验证指纹」总开关压制）。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoAcceptTrusted, Mode=TwoWay}"
                                          x:Uid="settings/autoAcceptTrusted"/>
                            <!-- 自动接收陌生（未信任）设备的文件：危险，默认关。仍受「接收前验证指纹」压制。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoAcceptStranger, Mode=TwoWay}"
                                          x:Uid="settings/autoAcceptStranger"
                                          OnContent="ON" OffContent="OFF"/>
                            <!-- 跨设备剪贴板同步：门控 0x11 推送的收/发。默认开。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ClipboardSync, Mode=TwoWay}"
                                          x:Uid="settings/clipboardSync"
                                          OnContent="ON" OffContent="OFF"/>
                            <!-- 登录时启动：真正写 HKCU Run 键。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}"
                                          x:Uid="settings/launchAtLogin"
                                          OnContent="ON" OffContent="OFF"/>
                            <!-- 任务栏图标活跃数徽标：tray host 订阅设置变化刷新 tooltip。 -->
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTrayBadge, Mode=TwoWay}"
                                          x:Uid="settings/trayBadge"
                                          OnContent="ON" OffContent="OFF"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Web 访问 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="settings/webAccessTag"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock x:Uid="settings/webAccessHint"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.WebGatewayEnabled, Mode=TwoWay}"
                                          x:Uid="settings/webGatewayToggle"
                                          OffContent="OFF"/>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="settings/webUrlLabel" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayUrl, Mode=OneWay}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource MdLimeBrush}"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="settings/pairingCodeLabel" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayPairingCode, Mode=OneWay}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="14"
                                               Foreground="{ThemeResource MdLimeBrush}"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Uid="settings/certHint"
                                       FontFamily="{StaticResource MdMonoFontFamily}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- About -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="settings/aboutTag"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="version" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ip" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Ip}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="device" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DeviceModel}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
