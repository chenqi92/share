<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls">

    <Grid Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,18,24,10" Spacing="4">
            <TextBlock Text="设置 · Settings"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontWeight="Bold"
                       FontSize="28"
                       CharacterSpacing="-25"/>
            <TextBlock Text="本机偏好 · 仅保存在本机"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="11"
                       Opacity="0.65"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,4,24,18">
            <StackPanel Spacing="22" MaxWidth="720" HorizontalAlignment="Left">

                <!-- 可见性 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="可见性 · VISIBILITY"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="谁能在 Nearby 看见你"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="设备名 · Display name" FontWeight="SemiBold" FontSize="12"/>
                                <TextBox Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                                         Background="{ThemeResource MdPaperBrush}"
                                         BorderBrush="{ThemeResource MdLineBrush}"
                                         CornerRadius="6"
                                         FontFamily="{StaticResource MdBodyFontFamily}"/>
                            </StackPanel>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Visible, Mode=TwoWay}"
                                          Header="对 LAN 可见"
                                          OffContent="OFF · 仅自己看到"
                                          OnContent="ON · LAN 内全部"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.HideAfterIdle, Mode=TwoWay}"
                                          Header="空闲 10 分钟后自动隐藏"
                                          OffContent="OFF"
                                          OnContent="ON"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 安全/加密 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="安全 · SECURITY"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="X25519 + ChaCha20-Poly1305 端到端"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="10"
                                   Opacity="0.55"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="本机指纹 · Fingerprint" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Fingerprint}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource MdLimeBrush}"/>
                                </Border>
                            </StackPanel>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.E2eRequired, Mode=TwoWay}"
                                          Header="强制要求 E2E（建议）"
                                          OnContent="ON · 协议层硬性要求"
                                          OffContent="OFF"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.RequireFingerprintConfirm, Mode=TwoWay}"
                                          Header="首次配对需双方确认指纹"
                                          OnContent="ON"
                                          OffContent="OFF"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 行为/接收 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="行为 · BEHAVIOR"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="接收路径、声音、开机自启"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="接收文件夹" FontWeight="SemiBold" FontSize="12"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.ReceiveDir, Mode=TwoWay}"
                                             Background="{ThemeResource MdPaperBrush}"
                                             BorderBrush="{ThemeResource MdLineBrush}"
                                             CornerRadius="6"
                                             FontFamily="{StaticResource MdMonoFontFamily}"/>
                                    <Button Grid.Column="1" Style="{StaticResource MdOutlineButtonStyle}">
                                        <TextBlock Text="浏览…"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoAccept, Mode=TwoWay}"
                                          Header="自动接收任何文件"
                                          OnContent="ON · 不再弹窗" OffContent="OFF · 每次确认"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoAcceptTrusted, Mode=TwoWay}"
                                          Header="自动接收已配对设备"
                                          OnContent="ON" OffContent="OFF"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.RingOnIncoming, Mode=TwoWay}"
                                          Header="接收时发声 · Toast 声"
                                          OnContent="ON" OffContent="OFF"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}"
                                          Header="开机自启动到托盘"
                                          OnContent="ON" OffContent="OFF"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTrayBadge, Mode=TwoWay}"
                                          Header="任务栏图标显示活跃数"
                                          OnContent="ON" OffContent="OFF"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Web 访问 -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Web 访问 · WEB ACCESS"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="浏览器走 LAN 网关访问"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.WebGatewayEnabled, Mode=TwoWay}"
                                          Header="启用 Web Gateway"
                                          OnContent="ON · LAN 浏览器可连"
                                          OffContent="OFF"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="访问地址 · URL" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayUrl, Mode=OneWay}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource MdLimeBrush}"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="配对码 · 24 小时有效" FontWeight="SemiBold" FontSize="12"/>
                                <Border CornerRadius="6" Padding="10,8,10,8"
                                        Background="{ThemeResource MdTerminalBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.WebGatewayPairingCode, Mode=OneWay}"
                                               FontFamily="{StaticResource MdMonoFontFamily}"
                                               FontSize="14"
                                               Foreground="{ThemeResource MdLimeBrush}"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="首次访问会弹证书提示，请在浏览器接受 meshdrop.local 自签证书。"
                                       FontFamily="{StaticResource MdMonoFontFamily}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- About -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="关于 · ABOUT"
                                   Style="{StaticResource MdMonoTagStyle}"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="12"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="version" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ip" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Ip}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="device" Style="{StaticResource MdTerminalLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DeviceModel}"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
