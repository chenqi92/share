<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    xmlns:mock="using:MeshDrop.Mock"
    xmlns:models="using:MeshDrop.Models">

    <Grid Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,18,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Uid="transfers/title"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="Bold"
                           FontSize="28"
                           CharacterSpacing="-25"/>
                <TextBlock x:Uid="transfers/subtitle"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="11"
                           Opacity="0.65"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ctrl:ChipControl x:Name="FilterAll" Tone="Ink"/>
                <ctrl:ChipControl x:Name="FilterActive" Tone="Outline"/>
                <ctrl:ChipControl x:Name="FilterDone" Tone="Outline"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,18" VerticalScrollMode="Enabled">
            <StackPanel Spacing="14">
                <ItemsControl ItemsSource="{x:Bind ViewModel.PendingOffers, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PendingFileOffer">
                            <Border Background="{ThemeResource MdCardBrush}" BorderBrush="{ThemeResource MdLimeDeepBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Uid="receive/waiting" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Peer.Name}"/>
                                    <TextBlock Text="{x:Bind FileName}" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind FormattedSize}"/>
                                    <TextBlock x:Uid="receive/saveHint" TextWrapping="Wrap" Opacity="0.7"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Tag="{x:Bind Id}" Click="OnAcceptFile" Style="{StaticResource MdAccentButtonStyle}">
                                            <TextBlock x:Uid="receive/accept"/>
                                        </Button>
                                        <Button Tag="{x:Bind Id}" Click="OnRejectFile" Style="{StaticResource MdOutlineButtonStyle}">
                                            <TextBlock x:Uid="common/reject"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 3 DashTile -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ctrl:DashTile Grid.Column="0"
                                   x:Name="SessionTile"
                                   Value="{x:Bind ViewModel.SessionValue, Mode=OneWay}"
                                   Hint="{x:Bind ViewModel.SessionHint, Mode=OneWay}"
                                   AccentBrush="{ThemeResource MdLimeDeepBrush}"
                                   Bars="{x:Bind ViewModel.SessionBars, Mode=OneWay}"/>
                    <ctrl:DashTile Grid.Column="1"
                                   x:Name="UpTile"
                                   Value="{x:Bind ViewModel.UpValue, Mode=OneWay}"
                                   Hint="{x:Bind ViewModel.UpHint, Mode=OneWay}"
                                   AccentBrush="{ThemeResource MdFlameBrush}"
                                   Bars="{x:Bind ViewModel.UploadBars, Mode=OneWay}"/>
                    <ctrl:DashTile Grid.Column="2"
                                   x:Name="DownTile"
                                   Value="{x:Bind ViewModel.DownValue, Mode=OneWay}"
                                   Hint="{x:Bind ViewModel.DownHint, Mode=OneWay}"
                                   AccentBrush="{ThemeResource MdSkyBrush}"
                                   Bars="{x:Bind ViewModel.DownloadBars, Mode=OneWay}"/>
                </Grid>

                <ctrl:AsciiDivider x:Name="TasksDivider"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.All, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mock:MockTransfer">
                            <ctrl:TransferRowControl Name="{x:Bind Name}"
                                                     Size="{x:Bind Size}"
                                                     Ext="{x:Bind Ext}"
                                                     FromTo="{x:Bind FromToText}"
                                                     State="{x:Bind State}"
                                                     Progress="{x:Bind Progress}"
                                                     Speed="{x:Bind Speed}"
                                                     Eta="{x:Bind Eta}"
                                                     LocalPath="{x:Bind LocalPath}"
                                                     Tag="{x:Bind}"
                                                     CancelRequested="OnRowCancelRequested"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
