<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    xmlns:vm="using:MeshDrop.ViewModels">

    <Grid Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="附近 · Nearby"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="Bold"
                           FontSize="28"
                           CharacterSpacing="-25"
                           Foreground="{ThemeResource MdInkBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="发现 · radar discovery"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10"
                               CharacterSpacing="100"
                               Opacity="0.55"/>
                    <TextBlock Text="·" Opacity="0.4"/>
                    <TextBlock Text="{x:Bind ViewModel.PeerCountText, Mode=OneWay}"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="11"
                               Opacity="0.7"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource MdOutlineButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="↑"/>
                        <TextBlock Text="发送文件…"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MdAccentButtonStyle}">
                    <TextBlock Text="+ 新会话"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content split: radar | rail -->
        <Grid Grid.Row="1" Padding="24,8,24,18" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="16"
                    Background="{ThemeResource MdCardBrush}"
                    BorderBrush="{ThemeResource MdLineBrush}"
                    BorderThickness="1"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <ctrl:ChipControl Text="LIVE" Tone="Lime" Mono="True"/>
                        <ctrl:ChipControl Text="E2E" Tone="Outline" Mono="True"/>
                        <ctrl:ChipControl Text="LAN ONLY" Tone="Outline" Mono="True"/>
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <ctrl:Radar x:Name="RadarCtl"
                                    Diameter="420"
                                    Variant="sweep"
                                    Devices="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                    SelectedId="{x:Bind ViewModel.SelectedId, Mode=OneWay}"/>
                    </Viewbox>
                    <ctrl:AsciiDivider Grid.Row="2" Label="── SWEEP 4.5s · PULSE 2.6s · 5 PEERS ──" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Details rail -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selected card -->
                <Border Grid.Row="0"
                        CornerRadius="14"
                        Background="{ThemeResource MdCardBrush}"
                        BorderBrush="{ThemeResource MdLineBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ctrl:AvatarControl Size="40" Initials="LL" ColorHex="#FFB4A1" ShowRing="Visible"/>
                            <StackPanel VerticalAlignment="Center" Spacing="-1">
                                <TextBlock Text="李莉"
                                           FontFamily="{StaticResource MdDisplayFontFamily}"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                                <TextBlock Text="Lily&#x2019;s MacBook"
                                           FontFamily="{StaticResource MdBodyFontFamily}"
                                           FontSize="12"
                                           Opacity="0.65"/>
                            </StackPanel>
                            <ctrl:ChipControl Text="SELECTED" Tone="Lime" Mono="True"
                                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <ctrl:AsciiDivider Label="── network details ──"/>

                        <!-- ★ Terminal block：Geist Mono 等宽 lime 文本 -->
                        <Border CornerRadius="8"
                                Background="{ThemeResource MdTerminalBrush}"
                                BorderBrush="{ThemeResource MdTerminalLineBrush}"
                                BorderThickness="1"
                                Padding="12,10,12,10">
                            <StackPanel Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ip"     Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="192.168.1.31"           Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="os"     Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="macOS 15.3"             Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="rtt"    Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="18 ms · jitter 0.4"     Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="bw"     Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="940 Mbps (LAN)"         Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="e2e"    Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="✓ verified"             Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="fpr"    Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="ZX8K · L72M · 9FQ3 · 7HD2"  Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button Style="{StaticResource MdAccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="→ 发送文件 · Send file"/>
                    </Button>
                    <Button Style="{StaticResource MdOutlineButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="◌ 开始聊天 · Start chat"/>
                    </Button>
                    <Button Style="{StaticResource MdOutlineButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock Text="⌶ 同步剪贴板 · Sync clipboard"/>
                    </Button>
                </StackPanel>

                <!-- Drop zone -->
                <Border Grid.Row="2"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource MdLimeBrush}"
                        BorderThickness="1.6"
                        Background="{ThemeResource MdLimeFaintBrush}"
                        VerticalAlignment="Stretch"
                        Padding="14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="⤓"
                                   FontFamily="{StaticResource MdDisplayFontFamily}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource MdLimeDeepBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="拖文件到这里"
                                   FontFamily="{StaticResource MdDisplayFontFamily}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="DROP · TO · SEND → 李莉"
                                   Style="{StaticResource MdMonoTagStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Mini footer -->
                <Border Grid.Row="3"
                        CornerRadius="10"
                        Background="{ThemeResource MdInk06Brush}"
                        Padding="10,6,10,6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="TIP" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Text="WIN+S 唤出 tray · Ctrl+, 打开设置"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="10"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
