<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    xmlns:vm="using:MeshDrop.ViewModels">

    <Grid Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Uid="discovery/title"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="Bold"
                           FontSize="28"
                           CharacterSpacing="-25"
                           Foreground="{ThemeResource MdInkBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Uid="discovery/subtitle"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10"
                               CharacterSpacing="100"
                               Opacity="0.55"/>
                    <TextBlock Text="·" Opacity="0.4"/>
                    <TextBlock Text="{x:Bind ViewModel.PeerCountText, Mode=OneWay}"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="11"
                               Opacity="0.7"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource MdOutlineButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="14"/>
                        <TextBlock x:Uid="discovery/sendFile"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MdAccentButtonStyle}">
                    <TextBlock x:Uid="discovery/newSession"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content split: radar | rail -->
        <Grid Grid.Row="1" Padding="24,8,24,18" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="16"
                    Background="{ThemeResource MdCardBrush}"
                    BorderBrush="{ThemeResource MdLineBrush}"
                    BorderThickness="1"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <ctrl:ChipControl x:Name="LiveChip" Tone="Lime" Mono="True"/>
                        <ctrl:ChipControl x:Name="PlaintextChip" Tone="Outline" Mono="True"/>
                        <ctrl:ChipControl x:Name="LanOnlyChip" Tone="Outline" Mono="True"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Viewbox Stretch="Uniform">
                            <ctrl:Radar x:Name="RadarCtl"
                                        Diameter="420"
                                        Variant="sweep"
                                        Devices="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                        SelectedId="{x:Bind ViewModel.SelectedId, Mode=OneWay}"/>
                        </Viewbox>

                        <!-- 扫描中 banner -->
                        <Border x:Name="ScanningBanner"
                                Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                Background="{ThemeResource MdInk06Brush}"
                                CornerRadius="999"
                                Padding="14,4,14,4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource MdSkyBrush}"/>
                                <TextBlock x:Uid="discovery/scanningBanner"
                                           FontFamily="{StaticResource MdMonoFontFamily}"
                                           FontSize="11"
                                           Foreground="{ThemeResource MdSkyBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 错误 banner -->
                        <Border x:Name="ErrorBanner"
                                Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                Background="{ThemeResource MdInk06Brush}"
                                BorderBrush="{ThemeResource MdFlameBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,6,14,6">
                            <TextBlock x:Name="ErrorText"
                                       x:Uid="discovery/networkError"
                                       FontFamily="{StaticResource MdMonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{ThemeResource MdFlameBrush}"/>
                        </Border>

                        <!-- 空态卡片 -->
                        <Border x:Name="EmptyCard"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="14"
                                Background="{ThemeResource MdCardBrush}"
                                BorderBrush="{ThemeResource MdLineBrush}"
                                BorderThickness="1"
                                Padding="22,18,22,18">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="◌"
                                           FontFamily="{StaticResource MdDisplayFontFamily}"
                                           FontSize="36"
                                           HorizontalAlignment="Center"
                                           Opacity="0.55"/>
                                <TextBlock x:Uid="discovery/emptyTitle"
                                           FontFamily="{StaticResource MdDisplayFontFamily}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="discovery/emptyHint"
                                           Style="{StaticResource MdMonoTagStyle}"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ctrl:AsciiDivider Grid.Row="2"
                                       x:Name="FooterDivider"
                                       Label="── SWEEP 4.5s · PULSE 2.6s · 0 PEERS ──"
                                       Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Details rail -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selected card -->
                <Border Grid.Row="0"
                        Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                        CornerRadius="14"
                        Background="{ThemeResource MdCardBrush}"
                        BorderBrush="{ThemeResource MdLineBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ctrl:AvatarControl Size="40" Initials="{x:Bind ViewModel.Selected.Initials, Mode=OneWay}" ColorHex="{x:Bind ViewModel.Selected.ColorHex, Mode=OneWay}" ShowRing="Visible"/>
                            <StackPanel VerticalAlignment="Center" Spacing="-1">
                                <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"
                                           FontFamily="{StaticResource MdDisplayFontFamily}"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                                <TextBlock Text="{x:Bind ViewModel.Selected.Os, Mode=OneWay}"
                                           FontFamily="{StaticResource MdBodyFontFamily}"
                                           FontSize="12"
                                           Opacity="0.65"/>
                            </StackPanel>
                            <ctrl:ChipControl Text="SELECTED" Tone="Lime" Mono="True"
                                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <ctrl:AsciiDivider Label="── network details ──"/>

                        <!-- ★ Terminal block：Geist Mono 等宽 lime 文本 -->
                        <Border CornerRadius="8"
                                Background="{ThemeResource MdTerminalBrush}"
                                BorderBrush="{ThemeResource MdTerminalLineBrush}"
                                BorderThickness="1"
                                Padding="12,10,12,10">
                            <StackPanel Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ip"     Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Selected.Ip, Mode=OneWay}"           Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="os"     Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Selected.Os, Mode=OneWay}"             Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="rtt"    Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Selected.Rtt, Mode=OneWay}"     Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="bw"     Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Selected.Bw, Mode=OneWay}"         Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="id"     Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Selected.Id, Mode=OneWay}"  Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="fpr"    Style="{StaticResource MdTerminalLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Selected.Fingerprint, Mode=OneWay}"  Style="{StaticResource MdTerminalValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="1" Spacing="6"
                            Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                    <Button Style="{StaticResource MdAccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock x:Uid="discovery/actionSend"/>
                    </Button>
                    <Button Style="{StaticResource MdOutlineButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock x:Uid="discovery/actionChat"/>
                    </Button>
                    <Button Style="{StaticResource MdOutlineButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <TextBlock x:Uid="discovery/actionClipboard"/>
                    </Button>
                </StackPanel>

                <!-- Drop zone -->
                <Border Grid.Row="2"
                        Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource MdLimeBrush}"
                        BorderThickness="1.6"
                        Background="{ThemeResource MdLimeFaintBrush}"
                        VerticalAlignment="Stretch"
                        Padding="14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE896;"
                                  FontSize="28"
                                  Foreground="{ThemeResource MdLimeDeepBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="discovery/dropTitle"
                                   FontFamily="{StaticResource MdDisplayFontFamily}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource MdMonoTagStyle}"><Run Text="DROP · TO · SEND → "/><Run Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>

                <!-- Mini footer -->
                <Border Grid.Row="3"
                        CornerRadius="10"
                        Background="{ThemeResource MdInk06Brush}"
                        Padding="10,6,10,6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Uid="discovery/tipLabel" Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock x:Uid="discovery/tipText"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="10"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- Empty state: no device selected -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        Visibility="{x:Bind ViewModel.EmptyDetailVisibility, Mode=OneWay}"
                        CornerRadius="14"
                        Background="{ThemeResource MdCardBrush}"
                        BorderBrush="{ThemeResource MdLineBrush}"
                        BorderThickness="1">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource MdInk60Brush}"
                               FontFamily="{StaticResource MdBodyFontFamily}"
                               FontSize="13"
                               Text="选择一台设备查看详情"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
