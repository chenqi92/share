<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    xmlns:mock="using:MeshDrop.Mock">

    <Grid Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="历史 · History"
                           FontFamily="{StaticResource MdDisplayFontFamily}"
                           FontWeight="Bold"
                           FontSize="28"
                           CharacterSpacing="-25"/>
                <TextBlock Text="6 件今天 · 12 件昨天 · 共 38 件"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="11"
                           Opacity="0.65"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ctrl:ChipControl Text="全部" Tone="Ink"/>
                <ctrl:ChipControl Text="文件" Tone="Outline"/>
                <ctrl:ChipControl Text="图片" Tone="Outline"/>
                <ctrl:ChipControl Text="文字" Tone="Outline"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,18">
            <StackPanel Spacing="14">
                <ctrl:AsciiDivider Label="── CLIPBOARD · 剪贴板同步 · 5 件 ──"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Clipboard, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mock:MockClipboard">
                            <Border CornerRadius="10"
                                    Background="{ThemeResource MdCardBrush}"
                                    BorderBrush="{ThemeResource MdLineBrush}"
                                    BorderThickness="1"
                                    Padding="12,10,12,10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:ChipControl Grid.Column="0" Text="{x:Bind KindLabel}" Tone="Outline" Mono="True" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Body}"
                                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxLines="3"
                                                   TextTrimming="WordEllipsis"/>
                                        <TextBlock FontFamily="{StaticResource MdMonoFontFamily}"
                                                   FontSize="10"
                                                   Opacity="0.55">
                                            <Run Text="from "/><Run Text="{x:Bind Who}"/><Run Text=" · "/><Run Text="{x:Bind Ago}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource MdOutlineButtonStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="复制"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ctrl:AsciiDivider Label="── TODAY · 今天 · 6 件 ──" Margin="0,8,0,0"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mock:MockHistory">
                            <Border CornerRadius="10"
                                    Background="{ThemeResource MdCardBrush}"
                                    BorderBrush="{ThemeResource MdLineBrush}"
                                    BorderThickness="1"
                                    Padding="14,10,14,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" Width="64">
                                        <TextBlock Text="{x:Bind Time}"
                                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MdLimeDeepBrush}"/>
                                        <TextBlock Text="{x:Bind DirArrow}"
                                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource MdInk60Brush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Peer}"
                                                       FontFamily="{StaticResource MdBodyFontFamily}"
                                                       FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="·" Opacity="0.4"/>
                                            <TextBlock Text="{x:Bind KindLabel}"
                                                       FontFamily="{StaticResource MdMonoFontFamily}"
                                                       FontSize="10"
                                                       Opacity="0.6"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Summary}"
                                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                                   FontSize="12"
                                                   Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ctrl:ChipControl Grid.Column="2"
                                                      Text="{x:Bind StatusLabel}"
                                                      Tone="{x:Bind StatusTone}"
                                                      Mono="True"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
