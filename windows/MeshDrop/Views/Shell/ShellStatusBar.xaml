<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Shell.ShellStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Height="{StaticResource MdStatusBarHeight}"
            Background="{ThemeResource MdPaper2Brush}"
            BorderBrush="{ThemeResource MdLineBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,0,14,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource MdLimeDeepBrush}"/>
                <TextBlock x:Name="StateLabel"
                           Text="ONLINE"
                           Style="{StaticResource MdMonoTagStyle}"
                           Foreground="{ThemeResource MdLimeDeepBrush}"/>
                <TextBlock Text="·" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock x:Name="IpLabel" Text="—" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock Text="·" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock x:Name="PeerCountLabel" Text="0 PEERS" Style="{StaticResource MdMonoTagStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ErrorLabel"
                           Text=""
                           Visibility="Collapsed"
                           Style="{StaticResource MdMonoTagStyle}"
                           Foreground="{ThemeResource MdFlameBrush}"/>
                <TextBlock x:Name="DisplayNameLabel" Text="—" Style="{StaticResource MdMonoTagStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
