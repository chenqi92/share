<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Shell.ShellStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Height="{StaticResource MdStatusBarHeight}"
            Background="{ThemeResource MdPaper2Brush}"
            BorderBrush="{ThemeResource MdLineBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,0,14,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource MdLimeDeepBrush}"/>
                <TextBlock Text="ONLINE"
                           Style="{StaticResource MdMonoTagStyle}"
                           Foreground="{ThemeResource MdLimeDeepBrush}"/>
                <TextBlock Text="·" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock Text="ACME-LAN" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock Text="·" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock Text="192.168.1.42" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock Text="·" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock Text="5 PEERS" Style="{StaticResource MdMonoTagStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdFlameBrush}">
                    <Run Text="↑"/><Run Text=" 8.4 MB/s"/>
                </TextBlock>
                <TextBlock Style="{StaticResource MdMonoTagStyle}" Foreground="{ThemeResource MdSkyBrush}">
                    <Run Text="↓"/><Run Text=" 11.7 MB/s"/>
                </TextBlock>
                <TextBlock Text="·" Style="{StaticResource MdMonoTagStyle}"/>
                <TextBlock Text="1.24 GB" Style="{StaticResource MdMonoTagStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
