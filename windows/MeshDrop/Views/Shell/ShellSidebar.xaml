<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Shell.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeshDrop.ViewModels"
    xmlns:mock="using:MeshDrop.Mock"
    xmlns:ctrl="using:MeshDrop.Views.Controls">

    <Border Background="{ThemeResource MdPaper2Brush}"
            BorderBrush="{ThemeResource MdLineBrush}"
            BorderThickness="0,0,1,0"
            Padding="16,20,12,12">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─ Logo + wordmark ─ -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                <ctrl:MeshDropLogo Size="22"/>
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="meshdrop"
                               FontFamily="{StaticResource MdDisplayFontFamily}"
                               FontWeight="SemiBold"
                               FontSize="17"
                               CharacterSpacing="-25"
                               Foreground="{ThemeResource MdInkBrush}"/>
                    <Ellipse Width="5" Height="5"
                             Fill="{ThemeResource MdLimeBrush}"
                             VerticalAlignment="Bottom"
                             Margin="1,0,0,4"/>
                </StackPanel>
            </StackPanel>

            <!-- ─ Search ─ -->
            <TextBox Grid.Row="1"
                     x:Uid="shell/search"
                     Background="{ThemeResource MdCardBrush}"
                     BorderBrush="{ThemeResource MdLineBrush}"
                     BorderThickness="1"
                     CornerRadius="8"
                     Height="32"
                     FontFamily="{StaticResource MdBodyFontFamily}"
                     FontSize="12"/>

            <!-- ─ Nav buttons ─ -->
            <StackPanel Grid.Row="2" Spacing="2">
                <!-- 选中态由 code-behind 的 SetActiveSection 驱动：lime@32%/16% 填充 + 1px lime 描边 + 选中标签用主文字色。
                     未选中标签默认次文字色（MdInk60），靠字重/颜色区分；NavLabel 命名用于高亮时切换前景与字重。 -->
                <Button Style="{StaticResource MdNavButtonStyle}" Click="OnDiscovery_Click" x:Name="NavDiscovery">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="◎" FontSize="13" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="NavDiscoveryLabel" x:Uid="shell/nav/nearby" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource MdInk60Brush}"/>
                        <ctrl:ChipControl Grid.Column="2" Text="{x:Bind ViewModel.NearbyCount, Mode=OneWay}" Tone="Lime" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource MdNavButtonStyle}" Click="OnChat_Click" x:Name="NavChat">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="◌" FontSize="13"/>
                        <TextBlock Grid.Column="1" x:Name="NavChatLabel" x:Uid="shell/nav/messages" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{ThemeResource MdInk60Brush}"/>
                        <ctrl:ChipControl Grid.Column="2" Text="{x:Bind ViewModel.UnreadChatCount, Mode=OneWay}" Tone="Flame" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource MdNavButtonStyle}" Click="OnTransfers_Click" x:Name="NavTransfers">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="↕" FontSize="13"/>
                        <TextBlock Grid.Column="1" x:Name="NavTransfersLabel" x:Uid="shell/nav/transfers" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{ThemeResource MdInk60Brush}"/>
                        <ctrl:ChipControl Grid.Column="2" x:Name="TransfersBadge" Text="{x:Bind ViewModel.ActiveTransfersText, Mode=OneWay}" Tone="Sky" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource MdNavButtonStyle}" Click="OnHistory_Click" x:Name="NavHistory">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="◉" FontSize="13"/>
                        <TextBlock Grid.Column="1" x:Name="NavHistoryLabel" x:Uid="shell/nav/history" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{ThemeResource MdInk60Brush}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource MdNavButtonStyle}" Click="OnClipboard_Click" x:Name="NavClipboard">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📋" FontSize="13"/>
                        <TextBlock Grid.Column="1" x:Name="NavClipboardLabel" x:Uid="shell/nav/clipboard" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{ThemeResource MdInk60Brush}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource MdNavButtonStyle}" Click="OnTrust_Click" x:Name="NavTrust">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="✓" FontSize="13" Foreground="{ThemeResource MdLimeDeepBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="NavTrustLabel" x:Uid="shell/nav/trust" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{ThemeResource MdInk60Brush}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource MdNavButtonStyle}" Click="OnSettings_Click" x:Name="NavSettings">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚙" FontSize="13"/>
                        <TextBlock Grid.Column="1" x:Name="NavSettingsLabel" x:Uid="shell/nav/settings" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{ThemeResource MdInk60Brush}"/>
                    </Grid>
                </Button>

                <!-- Paired devices section -->
                <ctrl:AsciiDivider x:Name="PairedDivider" Margin="4,12,4,4"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mock:MockDevice">
                            <Button Style="{StaticResource MdNavButtonStyle}"
                                    Padding="8,6,8,6"
                                    Click="OnPeer_Click"
                                    Tag="{x:Bind Id}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:AvatarControl Grid.Column="0"
                                                        Size="28"
                                                        Initials="{x:Bind Initials}"
                                                        ColorHex="{x:Bind ColorHex}"
                                                        VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="-1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ctrl:KindGlyph Size="10" Kind="{x:Bind Kind}"/>
                                            <TextBlock Text="{x:Bind Who}"
                                                       FontFamily="{StaticResource MdBodyFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Os}"
                                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                                   FontSize="9"
                                                   Opacity="0.55"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="2"
                                             Width="6" Height="6"
                                             Fill="{ThemeResource MdLimeDeepBrush}"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ─ 本机 self card ─ -->
            <Border Grid.Row="4"
                    CornerRadius="12"
                    Background="{ThemeResource MdCardBrush}"
                    BorderBrush="{ThemeResource MdLineBrush}"
                    BorderThickness="1"
                    Padding="10,10,10,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ctrl:AvatarControl Grid.Column="0"
                                        Size="34"
                                        Initials="{x:Bind ViewModel.SelfInitials, Mode=OneWay}"
                                        ColorHex="{x:Bind ViewModel.SelfColor, Mode=OneWay}"
                                        ShowRing="Visible"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                        <TextBlock Text="{x:Bind ViewModel.SelfDisplayName, Mode=OneWay}"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctrl:KindGlyph Size="10" Kind="Win"/>
                            <TextBlock Text="Win 11 · LAN"
                                       FontFamily="{StaticResource MdMonoFontFamily}"
                                       FontSize="9"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
