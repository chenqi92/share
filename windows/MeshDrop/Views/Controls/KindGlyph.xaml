<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Controls.KindGlyph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox Width="{x:Bind Size, Mode=OneWay}"
             Height="{x:Bind Size, Mode=OneWay}">
        <Grid Width="12" Height="12">
            <!-- Mac: 方框 + 底线 -->
            <Path x:Name="MacPath"
                  Stroke="{ThemeResource MdInk60Brush}" StrokeThickness="1.2"
                  Data="M 1 2 H 11 V 9 H 1 Z M 3 11 H 9"
                  Fill="Transparent"
                  Visibility="Collapsed"/>
            <!-- Win: 田字 -->
            <Path x:Name="WinPath"
                  Stroke="{ThemeResource MdInk60Brush}" StrokeThickness="1.2"
                  Data="M 1 1 H 5.5 V 5.5 H 1 Z M 6.5 1 H 11 V 5.5 H 6.5 Z M 1 6.5 H 5.5 V 11 H 1 Z M 6.5 6.5 H 11 V 11 H 6.5 Z"
                  Fill="Transparent"
                  Visibility="Collapsed"/>
            <!-- iPad: 圆角矩形 + 小圆 -->
            <Path x:Name="IpadPath"
                  Stroke="{ThemeResource MdInk60Brush}" StrokeThickness="1.2"
                  Data="M 2 1 H 10 A 1 1 0 0 1 11 2 V 10 A 1 1 0 0 1 10 11 H 2 A 1 1 0 0 1 1 10 V 2 A 1 1 0 0 1 2 1 Z"
                  Fill="Transparent"
                  Visibility="Collapsed"/>
            <Ellipse x:Name="IpadDot" Width="1.6" Height="1.6"
                     Fill="{ThemeResource MdInk60Brush}"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,0,1"
                     Visibility="Collapsed"/>
            <!-- iOS/Android: 圆角窄矩形 + 底线 -->
            <Path x:Name="PhonePath"
                  Stroke="{ThemeResource MdInk60Brush}" StrokeThickness="1.2"
                  Data="M 4 1 H 8 A 0.6 0.6 0 0 1 8.6 1.6 V 10.4 A 0.6 0.6 0 0 1 8 11 H 4 A 0.6 0.6 0 0 1 3.4 10.4 V 1.6 A 0.6 0.6 0 0 1 4 1 Z M 5 9.6 H 7"
                  Fill="Transparent"
                  Visibility="Collapsed"/>
            <!-- Linux: 简化企鹅头（菱形） -->
            <Path x:Name="LinuxPath"
                  Stroke="{ThemeResource MdInk60Brush}" StrokeThickness="1.2"
                  Data="M 6 1 L 10 6 L 6 11 L 2 6 Z M 4.5 5 L 7.5 5"
                  Fill="Transparent"
                  Visibility="Collapsed"/>
        </Grid>
    </Viewbox>
</UserControl>
