<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Controls.DashTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="14"
            Background="{ThemeResource MdCardBrush}"
            BorderBrush="{ThemeResource MdLineBrush}"
            BorderThickness="1"
            Padding="16,14,16,14">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6"
                         Fill="{x:Bind AccentBrush, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                           Style="{StaticResource MdMonoTagStyle}"/>
            </StackPanel>
            <TextBlock Text="{x:Bind Value, Mode=OneWay}"
                       FontFamily="{StaticResource MdDisplayFontFamily}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{x:Bind AccentBrush, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind Hint, Mode=OneWay}"
                       FontFamily="{StaticResource MdMonoFontFamily}"
                       FontSize="10"
                       Opacity="0.55"/>
            <StackPanel x:Name="BarsHost"
                        Orientation="Horizontal"
                        Spacing="3"
                        Margin="0,6,0,0"
                        VerticalAlignment="Bottom"/>
        </StackPanel>
    </Border>
</UserControl>
