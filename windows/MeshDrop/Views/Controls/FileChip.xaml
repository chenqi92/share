<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Controls.FileChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="10"
            Background="{ThemeResource MdCardBrush}"
            BorderBrush="{ThemeResource MdLineBrush}"
            BorderThickness="1"
            Padding="10,8,10,8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 纸样 icon -->
            <Border Grid.Column="0"
                    Width="34" Height="42"
                    CornerRadius="3"
                    Background="{ThemeResource MdPaperBrush}"
                    BorderBrush="{ThemeResource MdLineBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- 右上折角 -->
                    <Polygon Points="24,0 34,10 24,10"
                             Fill="{ThemeResource MdInk12Brush}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"/>
                    <!-- 扩展名 -->
                    <TextBlock Text="{x:Bind Ext, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource MdLimeDeepBrush}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                           FontFamily="{StaticResource MdBodyFontFamily}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource MdInkBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Size, Mode=OneWay}"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="10"
                           Foreground="{ThemeResource MdInk60Brush}"/>
                <ProgressBar x:Name="ProgressBarCtl"
                             Value="{x:Bind Progress, Mode=OneWay}"
                             Maximum="100"
                             Height="3"
                             Foreground="{ThemeResource MdLimeDeepBrush}"
                             Background="{ThemeResource MdInk12Brush}"
                             ShowError="False"
                             Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
