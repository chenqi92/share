<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Controls.TransferRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="12"
            Background="{ThemeResource MdCardBrush}"
            BorderBrush="{ThemeResource MdLineBrush}"
            BorderThickness="1"
            Padding="14,10,14,10">
        <Grid ColumnSpacing="14" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 文件 icon 38x46 -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                    Width="38" Height="46"
                    CornerRadius="4"
                    Background="{ThemeResource MdPaperBrush}"
                    BorderBrush="{ThemeResource MdLineBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                <Grid>
                    <Polygon Points="28,0 38,10 28,10"
                             Fill="{ThemeResource MdInk12Brush}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"/>
                    <TextBlock Text="{x:Bind Ext, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,5"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{x:Bind StateBrush, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- name + size -->
            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                           FontFamily="{StaticResource MdBodyFontFamily}"
                           FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Size, Mode=OneWay}"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="11"
                               Foreground="{ThemeResource MdInk60Brush}"/>
                    <TextBlock Text="·"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="11"
                               Foreground="{ThemeResource MdInk30Brush}"/>
                    <TextBlock Text="{x:Bind FromTo, Mode=OneWay}"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="11"
                               Foreground="{ThemeResource MdInk60Brush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 状态 / 速度 -->
            <StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                <TextBlock Text="{x:Bind StateText, Mode=OneWay}"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{x:Bind StateBrush, Mode=OneWay}"
                           HorizontalAlignment="Right"/>
                <TextBlock Text="{x:Bind EtaText, Mode=OneWay}"
                           FontFamily="{StaticResource MdMonoFontFamily}"
                           FontSize="10"
                           Foreground="{ThemeResource MdInk45Brush}"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- 进度条 -->
            <ProgressBar Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                         Value="{x:Bind Progress, Mode=OneWay}"
                         Maximum="100"
                         Height="4"
                         Margin="0,4,0,0"
                         Foreground="{x:Bind StateBrush, Mode=OneWay}"
                         Background="{ThemeResource MdInk12Brush}"
                         Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"/>
        </Grid>
    </Border>
</UserControl>
