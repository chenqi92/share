<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.Views.Controls.MsgBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeshDrop.Views.Controls">

    <Grid x:Name="Root" Margin="0,4,0,4">
        <Border x:Name="Bubble"
                MaxWidth="520"
                Padding="12,8,12,8"
                CornerRadius="16,16,16,6">
            <Border.ContextFlyout>
                <MenuFlyout Opening="OnMenuOpening">
                    <MenuFlyoutItem x:Name="CopyTextItem" x:Uid="msg/copy" Click="OnCopyText"/>
                    <MenuFlyoutItem x:Name="OpenFileItem" x:Uid="file/open" Click="OnFileOpen"/>
                    <MenuFlyoutItem x:Name="RevealFileItem" x:Uid="file/reveal" Click="OnFileReveal"/>
                    <MenuFlyoutItem x:Name="SaveFileItem" x:Uid="file/saveCopy" Click="OnFileSaveCopy"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="msg/delete" Click="OnDelete"/>
                </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel x:Name="Body" Spacing="6">
                <!-- 文本气泡 -->
                <RichTextBlock x:Name="TextRun"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MdBodyFontFamily}"
                               FontSize="14"
                               local:Linkify.Text="{x:Bind Text, Mode=OneWay}"/>
                <!-- 文件气泡 -->
                <Grid x:Name="FileRow" Visibility="Collapsed" ColumnSpacing="10"
                      Tapped="OnFileTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="42" CornerRadius="4"
                            Background="{ThemeResource MdCardBrush}"
                            BorderBrush="{ThemeResource MdLineBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="FileExtText"
                                   Text="{x:Bind FileExt, Mode=OneWay}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource MdInk60Brush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="FileNameText" Text="{x:Bind FileName, Mode=OneWay}"
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FileSizeText" Text="{x:Bind FileSize, Mode=OneWay}"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="10"
                                   Opacity="0.6"/>
                    </StackPanel>
                </Grid>
                <!-- 时间戳行 -->
                <TextBlock x:Name="TransferStatusText" Text="{x:Bind StatusText, Mode=OneWay}"
                           FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <TextBlock x:Name="TimeText"
                               Text="{x:Bind Time, Mode=OneWay}"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10"
                               Opacity="0.55"/>
                    <TextBlock x:Name="DeliveredText"
                               Visibility="Collapsed"
                               x:Uid="msg/delivered"
                               FontFamily="{StaticResource MdMonoFontFamily}"
                               FontSize="10"
                               Foreground="{ThemeResource MdLimeDeepBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
