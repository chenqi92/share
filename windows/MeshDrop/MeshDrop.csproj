<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MeshDrop</RootNamespace>
    <AssemblyName>MeshDrop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 我们在 App.xaml.cs 自己写了 Program.Main 来设置 SynchronizationContext；
         禁用 XAML 编译器自动生成的 Program.Main 避免重复 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!--
      抑制 MVVMTK0045：[ObservableProperty] 字段在未来 CsWinRT AOT 路径下应改成
      partial property（C# 13 / .NET 9），但本项目还在 .NET 8。等升级到 .NET 9
      时再整体切。
      CS0067：RelayCommand.CanExecuteChanged 是 ICommand 接口要求的事件，
      我们的简化实现没用到它，但接口契约必须声明。
    -->
    <NoWarn>$(NoWarn);MVVMTK0045;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
    <!-- DPAPI (ProtectedData) 在 .NET Core 之后剥离到独立包，需显式引用 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.4" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Include="Assets\**" />
  </ItemGroup>
</Project>
