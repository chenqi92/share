<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        若 Assets\Fonts\ 下放了 OFL 字体文件，下面的 ms-appx 路径会自动生效。
        否则回退到系统字体 (Segoe UI Variable / Cascadia Mono)，保持构建通过。
        嵌入字体加载语法：  ms-appx:///Assets/Fonts/<file>.ttf#<FamilyName>
    -->

    <FontFamily x:Key="MdDisplayFontFamily">ms-appx:///Assets/Fonts/SpaceGrotesk-Variable.ttf#Space Grotesk, Segoe UI Variable Display, Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="MdBodyFontFamily">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist, Segoe UI Variable Text, Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="MdMonoFontFamily">ms-appx:///Assets/Fonts/GeistMono-Variable.ttf#Geist Mono, Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

    <!-- 字号阶梯 (COMMON §6) -->
    <x:Double x:Key="MdFontHero">32</x:Double>
    <x:Double x:Key="MdFontTitle">22</x:Double>
    <x:Double x:Key="MdFontSubtitle">18</x:Double>
    <x:Double x:Key="MdFontCardTitle">14</x:Double>
    <x:Double x:Key="MdFontBody">13</x:Double>
    <x:Double x:Key="MdFontMeta">11</x:Double>
    <x:Double x:Key="MdFontTag">11</x:Double>
    <x:Double x:Key="MdFontAscii">10</x:Double>

</ResourceDictionary>
