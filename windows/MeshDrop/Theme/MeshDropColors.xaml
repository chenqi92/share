<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ─── LIGHT ─────────────────────────────────────────────────── -->
        <ResourceDictionary x:Key="Light">
            <!-- 文字 / 描边 -->
            <Color x:Key="MdInkColor">#FF0A0A0A</Color>
            <Color x:Key="MdInk80Color">#CC0A0A0A</Color>
            <Color x:Key="MdInk60Color">#990A0A0A</Color>
            <Color x:Key="MdInk45Color">#730A0A0A</Color>
            <Color x:Key="MdInk30Color">#4D0A0A0A</Color>
            <Color x:Key="MdInk12Color">#1F0A0A0A</Color>
            <Color x:Key="MdInk06Color">#0F0A0A0A</Color>

            <!-- 背景 -->
            <Color x:Key="MdPaperColor">#FFF5F2EC</Color>
            <Color x:Key="MdPaper2Color">#FFEDE8DD</Color>
            <Color x:Key="MdCardColor">#FFFFFFFF</Color>
            <Color x:Key="MdLineColor">#FFE2DCCD</Color>
            <Color x:Key="MdGlassColor">#8CFFFFFF</Color>
            <Color x:Key="MdTerminalColor">#FF0E0C09</Color>
            <Color x:Key="MdTerminalLineColor">#1AFFFFFF</Color>

            <!-- Accent · LIME -->
            <Color x:Key="MdLimeColor">#FFDDF94B</Color>
            <Color x:Key="MdLimeDeepColor">#FFA8C800</Color>
            <Color x:Key="MdLimeFillColor">#52DDF94B</Color>
            <Color x:Key="MdLimeFaintColor">#1FDDF94B</Color>

            <!-- Accent · FLAME / SKY -->
            <Color x:Key="MdFlameColor">#FFFF5A2C</Color>
            <Color x:Key="MdFlameDeepColor">#FFC73E15</Color>
            <Color x:Key="MdSkyColor">#FF4DB8FF</Color>
            <Color x:Key="MdErrorColor">#FFC4322B</Color>

            <!-- Outgoing 气泡（light=ink 黑底 paper 字） -->
            <Color x:Key="MdBubbleOutBgColor">#FF0A0A0A</Color>
            <Color x:Key="MdBubbleOutFgColor">#FFF5F2EC</Color>
            <Color x:Key="MdBubbleInBgColor">#FFFFFFFF</Color>
            <Color x:Key="MdBubbleInFgColor">#FF0A0A0A</Color>

            <SolidColorBrush x:Key="MdInkBrush" Color="{ThemeResource MdInkColor}"/>
            <SolidColorBrush x:Key="MdInk80Brush" Color="{ThemeResource MdInk80Color}"/>
            <SolidColorBrush x:Key="MdInk60Brush" Color="{ThemeResource MdInk60Color}"/>
            <SolidColorBrush x:Key="MdInk45Brush" Color="{ThemeResource MdInk45Color}"/>
            <SolidColorBrush x:Key="MdInk30Brush" Color="{ThemeResource MdInk30Color}"/>
            <SolidColorBrush x:Key="MdInk12Brush" Color="{ThemeResource MdInk12Color}"/>
            <SolidColorBrush x:Key="MdInk06Brush" Color="{ThemeResource MdInk06Color}"/>
            <SolidColorBrush x:Key="MdPaperBrush" Color="{ThemeResource MdPaperColor}"/>
            <SolidColorBrush x:Key="MdPaper2Brush" Color="{ThemeResource MdPaper2Color}"/>
            <SolidColorBrush x:Key="MdCardBrush" Color="{ThemeResource MdCardColor}"/>
            <SolidColorBrush x:Key="MdLineBrush" Color="{ThemeResource MdLineColor}"/>
            <SolidColorBrush x:Key="MdGlassBrush" Color="{ThemeResource MdGlassColor}"/>
            <SolidColorBrush x:Key="MdTerminalBrush" Color="{ThemeResource MdTerminalColor}"/>
            <SolidColorBrush x:Key="MdTerminalLineBrush" Color="{ThemeResource MdTerminalLineColor}"/>
            <SolidColorBrush x:Key="MdLimeBrush" Color="{ThemeResource MdLimeColor}"/>
            <SolidColorBrush x:Key="MdLimeDeepBrush" Color="{ThemeResource MdLimeDeepColor}"/>
            <SolidColorBrush x:Key="MdLimeFillBrush" Color="{ThemeResource MdLimeFillColor}"/>
            <SolidColorBrush x:Key="MdLimeFaintBrush" Color="{ThemeResource MdLimeFaintColor}"/>
            <SolidColorBrush x:Key="MdFlameBrush" Color="{ThemeResource MdFlameColor}"/>
            <SolidColorBrush x:Key="MdFlameDeepBrush" Color="{ThemeResource MdFlameDeepColor}"/>
            <SolidColorBrush x:Key="MdSkyBrush" Color="{ThemeResource MdSkyColor}"/>
            <SolidColorBrush x:Key="MdErrorBrush" Color="{ThemeResource MdErrorColor}"/>
            <SolidColorBrush x:Key="MdBubbleOutBgBrush" Color="{ThemeResource MdBubbleOutBgColor}"/>
            <SolidColorBrush x:Key="MdBubbleOutFgBrush" Color="{ThemeResource MdBubbleOutFgColor}"/>
            <SolidColorBrush x:Key="MdBubbleInBgBrush" Color="{ThemeResource MdBubbleInBgColor}"/>
            <SolidColorBrush x:Key="MdBubbleInFgBrush" Color="{ThemeResource MdBubbleInFgColor}"/>

            <!-- 覆盖 WinUI 默认 Accent，让所有内置 Accent 引用都落到 lime -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource MdLimeDeepColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource MdLimeColor}"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource MdLimeFillColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource MdInkColor}"/>
            <Color x:Key="SystemAccentColor">#FFDDF94B</Color>
            <Color x:Key="SystemAccentColorDark1">#FFA8C800</Color>
            <Color x:Key="SystemAccentColorDark2">#FF8FB000</Color>
            <Color x:Key="SystemAccentColorLight1">#FFE7FB7A</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF0FCA8</Color>
        </ResourceDictionary>

        <!-- ─── DARK ──────────────────────────────────────────────────── -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="MdInkColor">#FFE8E3D6</Color>
            <Color x:Key="MdInk80Color">#CCE8E3D6</Color>
            <Color x:Key="MdInk60Color">#99E8E3D6</Color>
            <Color x:Key="MdInk45Color">#80FFFFFF</Color>
            <Color x:Key="MdInk30Color">#4DFFFFFF</Color>
            <Color x:Key="MdInk12Color">#1FFFFFFF</Color>
            <Color x:Key="MdInk06Color">#0FFFFFFF</Color>

            <Color x:Key="MdPaperColor">#FF0E0C09</Color>
            <Color x:Key="MdPaper2Color">#FF181612</Color>
            <Color x:Key="MdCardColor">#FF181612</Color>
            <Color x:Key="MdLineColor">#1AFFFFFF</Color>
            <Color x:Key="MdGlassColor">#06FFFFFF</Color>
            <Color x:Key="MdTerminalColor">#FF050402</Color>
            <Color x:Key="MdTerminalLineColor">#26FFFFFF</Color>

            <Color x:Key="MdLimeColor">#FFDDF94B</Color>
            <Color x:Key="MdLimeDeepColor">#FFA8C800</Color>
            <Color x:Key="MdLimeFillColor">#29DDF94B</Color>
            <Color x:Key="MdLimeFaintColor">#14DDF94B</Color>

            <Color x:Key="MdFlameColor">#FFFF5A2C</Color>
            <Color x:Key="MdFlameDeepColor">#FFC73E15</Color>
            <Color x:Key="MdSkyColor">#FF4DB8FF</Color>
            <Color x:Key="MdErrorColor">#FFC4322B</Color>

            <!-- Outgoing 气泡（dark=lime 底 ink 字） -->
            <Color x:Key="MdBubbleOutBgColor">#FFDDF94B</Color>
            <Color x:Key="MdBubbleOutFgColor">#FF0A0A0A</Color>
            <Color x:Key="MdBubbleInBgColor">#12FFFFFF</Color>
            <Color x:Key="MdBubbleInFgColor">#FFE8E3D6</Color>

            <SolidColorBrush x:Key="MdInkBrush" Color="{ThemeResource MdInkColor}"/>
            <SolidColorBrush x:Key="MdInk80Brush" Color="{ThemeResource MdInk80Color}"/>
            <SolidColorBrush x:Key="MdInk60Brush" Color="{ThemeResource MdInk60Color}"/>
            <SolidColorBrush x:Key="MdInk45Brush" Color="{ThemeResource MdInk45Color}"/>
            <SolidColorBrush x:Key="MdInk30Brush" Color="{ThemeResource MdInk30Color}"/>
            <SolidColorBrush x:Key="MdInk12Brush" Color="{ThemeResource MdInk12Color}"/>
            <SolidColorBrush x:Key="MdInk06Brush" Color="{ThemeResource MdInk06Color}"/>
            <SolidColorBrush x:Key="MdPaperBrush" Color="{ThemeResource MdPaperColor}"/>
            <SolidColorBrush x:Key="MdPaper2Brush" Color="{ThemeResource MdPaper2Color}"/>
            <SolidColorBrush x:Key="MdCardBrush" Color="{ThemeResource MdCardColor}"/>
            <SolidColorBrush x:Key="MdLineBrush" Color="{ThemeResource MdLineColor}"/>
            <SolidColorBrush x:Key="MdGlassBrush" Color="{ThemeResource MdGlassColor}"/>
            <SolidColorBrush x:Key="MdTerminalBrush" Color="{ThemeResource MdTerminalColor}"/>
            <SolidColorBrush x:Key="MdTerminalLineBrush" Color="{ThemeResource MdTerminalLineColor}"/>
            <SolidColorBrush x:Key="MdLimeBrush" Color="{ThemeResource MdLimeColor}"/>
            <SolidColorBrush x:Key="MdLimeDeepBrush" Color="{ThemeResource MdLimeDeepColor}"/>
            <SolidColorBrush x:Key="MdLimeFillBrush" Color="{ThemeResource MdLimeFillColor}"/>
            <SolidColorBrush x:Key="MdLimeFaintBrush" Color="{ThemeResource MdLimeFaintColor}"/>
            <SolidColorBrush x:Key="MdFlameBrush" Color="{ThemeResource MdFlameColor}"/>
            <SolidColorBrush x:Key="MdFlameDeepBrush" Color="{ThemeResource MdFlameDeepColor}"/>
            <SolidColorBrush x:Key="MdSkyBrush" Color="{ThemeResource MdSkyColor}"/>
            <SolidColorBrush x:Key="MdErrorBrush" Color="{ThemeResource MdErrorColor}"/>
            <SolidColorBrush x:Key="MdBubbleOutBgBrush" Color="{ThemeResource MdBubbleOutBgColor}"/>
            <SolidColorBrush x:Key="MdBubbleOutFgBrush" Color="{ThemeResource MdBubbleOutFgColor}"/>
            <SolidColorBrush x:Key="MdBubbleInBgBrush" Color="{ThemeResource MdBubbleInBgColor}"/>
            <SolidColorBrush x:Key="MdBubbleInFgBrush" Color="{ThemeResource MdBubbleInFgColor}"/>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource MdLimeColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource MdLimeDeepColor}"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource MdLimeFillColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource MdLimeColor}"/>
            <Color x:Key="SystemAccentColor">#FFDDF94B</Color>
            <Color x:Key="SystemAccentColorDark1">#FFA8C800</Color>
            <Color x:Key="SystemAccentColorDark2">#FF8FB000</Color>
            <Color x:Key="SystemAccentColorLight1">#FFE7FB7A</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF0FCA8</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
