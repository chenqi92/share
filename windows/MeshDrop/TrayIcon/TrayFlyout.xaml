<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeshDrop.TrayIcon.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:MeshDrop.Views.Controls"
    xmlns:mock="using:MeshDrop.Mock"
    Width="360">

    <Border CornerRadius="14"
            Background="{ThemeResource MdCardBrush}"
            BorderBrush="{ThemeResource MdLineBrush}"
            BorderThickness="1"
            Padding="14,12,14,12">
        <StackPanel Spacing="12">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <ctrl:MeshDropLogo Size="18"/>
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="meshdrop"
                                   FontFamily="{StaticResource MdDisplayFontFamily}"
                                   FontWeight="SemiBold" FontSize="14"
                                   CharacterSpacing="-25"/>
                        <Ellipse Width="4" Height="4"
                                 Fill="{ThemeResource MdLimeBrush}"
                                 VerticalAlignment="Bottom" Margin="1,0,0,3"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource MdLimeDeepBrush}"/>
                    <TextBlock x:Name="OnlineCount" Text="0 ONLINE"
                               Style="{StaticResource MdMonoTagStyle}"
                               Foreground="{ThemeResource MdLimeDeepBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Live transfer mini bar (隐藏除非有进行中传输，ShareEngine 暂未提供 inflight 状态) -->
            <Border x:Name="LiveTransferBar"
                    Visibility="Collapsed"
                    CornerRadius="10"
                    Background="{ThemeResource MdPaper2Brush}"
                    Padding="12,10,12,10">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="↑"
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   Foreground="{ThemeResource MdFlameBrush}"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LiveTransferName" Grid.Column="1" Text=""
                                   FontFamily="{StaticResource MdBodyFontFamily}"
                                   FontWeight="SemiBold" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LiveTransferStat" Grid.Column="2" Text=""
                                   FontFamily="{StaticResource MdMonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{ThemeResource MdFlameBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="LiveTransferBarValue" Value="0" Maximum="100" Height="4"
                                 Background="{ThemeResource MdInk12Brush}"
                                 Foreground="{ThemeResource MdFlameBrush}"/>
                </StackPanel>
            </Border>

            <ctrl:AsciiDivider x:Name="NearbyDivider" Label="── NEARBY ──"/>

            <ItemsControl ItemsSource="{x:Bind Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mock:MockDevice">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:AvatarControl Grid.Column="0" Size="26"
                                                Initials="{x:Bind Initials}"
                                                ColorHex="{x:Bind ColorHex}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                                <TextBlock Text="{x:Bind Who}"
                                           FontFamily="{StaticResource MdBodyFontFamily}"
                                           FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock FontFamily="{StaticResource MdMonoFontFamily}" FontSize="9" Opacity="0.55">
                                    <Run Text="{x:Bind Os}"/><Run Text=" · "/><Run Text="{x:Bind Rtt}"/><Run Text=" ms"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource MdOutlineButtonStyle}"
                                    Padding="10,4,10,4"
                                    Tag="{x:Bind Id}"
                                    Click="SendClipboard_Click"
                                    ToolTipService.ToolTip="把剪贴板里的文字 / URL 立即发给该设备">
                                <TextBlock Text="发送" FontSize="11"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ctrl:AsciiDivider Label="── ACTIONS ──"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource MdAccentButtonStyle}" HorizontalAlignment="Stretch" Click="OpenMain_Click">
                    <TextBlock Text="打开 meshdrop"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource MdOutlineButtonStyle}" Click="OpenSettings_Click">
                    <TextBlock Text="⚙"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
