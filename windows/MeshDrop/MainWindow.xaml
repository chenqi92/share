<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeshDrop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:MeshDrop.Views.Shell"
    xmlns:pages="using:MeshDrop.Views.Pages">

    <Grid x:Name="RootGrid" Background="{ThemeResource MdPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="IncomingFilesBar" Grid.Row="0" IsOpen="False" IsClosable="False"
                 Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="ReviewIncomingFilesButton" Click="OnReviewIncomingFiles"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <shell:ShellSidebar x:Name="Sidebar" Grid.Column="0"/>

            <Grid x:Name="MainHost" Grid.Column="1">
                <pages:DiscoveryPage x:Name="DiscoveryPg"/>
                <pages:ChatPage x:Name="ChatPg"        Visibility="Collapsed"/>
                <pages:TransfersPage x:Name="TransfersPg" Visibility="Collapsed"/>
                <pages:HistoryPage x:Name="HistoryPg"  Visibility="Collapsed"/>
                <pages:ClipboardPage x:Name="ClipboardPg" Visibility="Collapsed"/>
                <pages:TrustPage x:Name="TrustPg"      Visibility="Collapsed"/>
                <pages:SettingsPage x:Name="SettingsPg" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <shell:ShellStatusBar Grid.Row="2"/>
    </Grid>
</Window>
