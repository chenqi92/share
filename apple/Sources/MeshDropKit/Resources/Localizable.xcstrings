{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "bluetooth.denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie MeshDrop den Bluetooth-Zugriff in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Bluetooth access for MeshDrop in system settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a MeshDrop acceder a Bluetooth en los ajustes del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès Bluetooth pour MeshDrop dans les réglages système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でMeshDropのBluetoothアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 MeshDrop의 Bluetooth 접근을 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 MeshDrop 使用蓝牙"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設置中允許 MeshDrop 使用藍牙"
          }
        }
      }
    },
    "bluetooth.off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Bluetooth auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Bluetooth on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Bluetooth en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Bluetooth sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのBluetoothをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 Bluetooth를 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请开启设备蓝牙"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啓設備藍牙"
          }
        }
      }
    },
    "bluetooth.ready": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ist aktiviert. Geräte in der Nähe werden gesucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is on. Discovering nearby devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth activado. Buscando dispositivos cercanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth activé. Recherche d’appareils à proximité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothがオンです。近くのデバイスを検索しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth가 켜져 있습니다. 주변 기기를 검색합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已开启，正在发现附近设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙已開啓，正在發現附近設備"
          }
        }
      }
    },
    "bluetooth.starting": {
      "extractionState": "manual",
      "localizations": {
