    "connection.busy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragung belegt. Bitte erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer busy. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferencia ocupada. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfert occupé. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送がビジー状態です。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이 사용 중입니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输繁忙，请稍后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳輸繁忙，請稍後重試"
          }
        }
      }
    },
    "connection.closed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión se ha cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été fermée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切断されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 종료되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已断开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接已斷開"
          }
        }
      }
    },
    "connection.routeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Übertragung ist nicht verfügbar. Suchen Sie das Gerät erneut oder wählen Sie einen anderen Weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected transport is unavailable. Discover the device again or choose another transport."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El transporte elegido no está disponible. Busca el dispositivo de nuevo o elige otro transporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode choisi est indisponible. Recherchez à nouveau l’appareil ou choisissez un autre mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した転送方式を利用できません。デバイスを再検索するか、別の方式を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 전송 방식을 사용할 수 없습니다. 기기를 다시 검색하거나 다른 방식을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选传输通道不可用，请重新搜索设备或切换通道"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選傳輸通道不可用，請重新搜索設備或切換通道"
          }
        }
      }
    },
    "connection.timeout": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung. Prüfen Sie, ob MeshDrop auf dem anderen Gerät geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection timed out. Make sure MeshDrop is open on the other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión agotada. Comprueba que MeshDrop esté abierto en el otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion expirée. Vérifiez que MeshDrop est ouvert sur l’autre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がタイムアウトしました。相手のデバイスでMeshDropが開いていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 시간이 초과되었습니다. 상대 기기에서 MeshDrop이 열려 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时，请确认对方已打开 MeshDrop"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接超時，請確認對方已打開 MeshDrop"
          }
        }
      }
    },
