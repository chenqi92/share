    "discovery.unavailable": {
      "comment": "发现层不可用：通常是本地网络权限被拒。",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Netzwerk nicht verfügbar. Erlauben Sie MeshDrop den Zugriff in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network unavailable. Allow MeshDrop to access the local network in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red local no disponible. Permite el acceso a MeshDrop en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseau local indisponible. Autorisez l’accès pour MeshDrop dans Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークを利用できません。設定でMeshDropのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크를 사용할 수 없습니다. 설정에서 MeshDrop의 로컬 네트워크 접근을 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络不可用，请在系统设置中允许 MeshDrop 访问本地网络"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地網絡不可用，請在系統設置中允許 MeshDrop 訪問本地網絡"
          }
        }
      }
    },
