        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在啓動藍牙"
          }
        }
      }
    },
    "bluetooth.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-Übertragung ist auf diesem Gerät nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth transfer is unavailable on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia Bluetooth no está disponible en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert Bluetooth est indisponible sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではBluetooth転送を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 Bluetooth 전송을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持蓝牙传输"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設備不支持藍牙傳輸"
          }
        }
      }
    },
