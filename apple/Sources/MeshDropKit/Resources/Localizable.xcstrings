          }
        }
      }
    },
    "history.delete.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den lokalen Eintrag, empfangene Dateien und App-Kopien dauerhaft. Ihre gesendeten Originaldateien und der Verlauf des anderen Geräts bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes the local entry, received files, and app-managed copies. Your original sent files and the other device’s history are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente la entrada local, los archivos recibidos y las copias de la app. Conserva los originales enviados y el historial del otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement l’entrée locale, les fichiers reçus et les copies de l’app. Les originaux envoyés et l’historique de l’autre appareil sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの履歴、受信ファイル、アプリが保存したコピーを完全に削除します。送信元の元ファイルと相手の履歴は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 기록, 받은 파일 및 앱이 관리하는 사본을 영구 삭제합니다. 원본 전송 파일과 상대 기기의 기록은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除本机记录、接收文件和 App 保存的副本。发送前的原始文件及对方设备上的记录不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除本機記錄、接收文件和 App 保存的副本。發送前的原始文件及對方設備上的記錄不受影響。"
          }
        }
      }
    },
