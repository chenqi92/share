    "route.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth funktioniert ohne WLAN. Apple Peer-to-Peer benötigt aktiviertes WLAN, aber kein gemeinsames Netzwerk. Lassen Sie MeshDrop auf beiden Geräten geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth works without Wi-Fi. Apple peer-to-peer needs Wi-Fi enabled, but not a shared network. Keep MeshDrop open on both devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth funciona sin Wi-Fi. Punto a punto de Apple requiere Wi-Fi activado, pero no una red compartida. Mantén MeshDrop abierto en ambos dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth fonctionne sans Wi-Fi. Le pair-à-pair Apple nécessite le Wi-Fi activé, sans réseau commun. Gardez MeshDrop ouvert sur les deux appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BluetoothはWi-Fiなしで使えます。AppleピアツーピアはWi-Fiをオンにする必要がありますが、同じネットワークへの接続は不要です。両方のデバイスでMeshDropを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth는 Wi-Fi 없이 작동합니다. Apple P2P는 Wi-Fi가 켜져 있어야 하지만 같은 네트워크일 필요는 없습니다. 양쪽에서 MeshDrop을 열어 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙无需 Wi-Fi；Apple 点对点无需连接同一网络，但需要开启 Wi-Fi。双方需打开 MeshDrop。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙無需 Wi-Fi；Apple 點對點無需連接同一網絡，但需要開啓 Wi-Fi。雙方需打開 MeshDrop。"
          }
        }
      }
    },
    "route.enableBluetooth": {
