    "settings.security.resetConfirm.message": {
      "comment": "设置·安全：重置身份确认对话框正文",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zurücksetzen werden eine neue ID und neue Schlüssel erstellt. Alle Geräte müssen erneut gekoppelt werden. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetting identity creates a new ID and key pair; all paired peers will treat this device as new and must re-pair. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer la identidad crea un ID y unas claves nuevas. Todos los dispositivos deberán volver a enlazarse. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser l’identité crée un nouvel identifiant et de nouvelles clés. Tous les appareils devront être jumelés à nouveau. Continuer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDをリセットすると新しいIDと鍵ペアが作成されます。すべての相手と再ペアリングが必要になります。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원을 초기화하면 새 ID와 키 쌍이 생성됩니다. 모든 기기와 다시 페어링해야 합니다. 계속할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置身份会生成新的 ID 与密钥对，所有已配对的对端会把本机视为新设备需要重新配对。继续？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置身份會生成新的 ID 與密鑰對，所有已配對的對端會把本機視為新設備需要重新配對。繼續？"
          }
        }
      }
    },
    "settings.security.transport.detail": {
      "comment": "设置·安全：传输安全副文案",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.3 für LAN und Peer-to-Peer; Systemverschlüsselung für Bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.3 for LAN and peer-to-peer; system link encryption for Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.3 para LAN y punto a punto; cifrado del sistema para Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.3 pour le réseau local et le pair-à-pair ; chiffrement système pour Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LANとピアツーピアはTLS 1.3、Bluetoothはシステムのリンク暗号化を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN과 P2P는 TLS 1.3, Bluetooth는 시스템 링크 암호화를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网与点对点使用 TLS 1.3；蓝牙使用系统链路加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "局域網與點對點使用 TLS 1.3；藍牙使用系統鏈路加密。"
          }
        }
      }
    },
