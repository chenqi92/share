    "trust.empty.subtitle": {
      "comment": "信任空态副标题",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der ersten Verbindung eines neuen Geräts erscheint eine Kopplungsanfrage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pairing request pops up the first time a new device connects"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera conexión de un dispositivo muestra una solicitud de enlace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande de jumelage apparaît à la première connexion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいデバイスが初めて接続するとペアリング要求が表示されます"
