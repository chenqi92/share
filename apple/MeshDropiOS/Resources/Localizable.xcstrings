    "pendingShare.noDevices.footer": {
      "comment": "待发分享：无设备时的脚注",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Geräte in der Nähe. Öffnen Sie MeshDrop auf dem anderen Gerät im selben WLAN. Wählen Sie es aus, sobald es erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No devices nearby. Make sure the other party is on the same Wi-Fi with MeshDrop open; you can choose once it appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay dispositivos cerca. Comprueba que el otro dispositivo tenga MeshDrop abierto en la misma red Wi-Fi y selecciónalo cuando aparezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil à proximité. Vérifiez que l’autre appareil a ouvert MeshDrop sur le même Wi-Fi, puis sélectionnez-le lorsqu’il apparaît."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにデバイスがありません。相手が同じWi-FiでMeshDropを開いていることを確認してください。表示後に選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기가 없습니다. 상대방이 같은 Wi-Fi에서 MeshDrop을 열었는지 확인하세요. 표시되면 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近暂无设备。确保对方在同一 Wi-Fi 且打开了 MeshDrop，设备出现后即可选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近暫無設備。確保對方在同一 Wi-Fi 且打開了 MeshDrop，設備出現後即可選擇。"
          }
        }
      }
    },
