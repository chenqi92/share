    "pairing.fingerprint.hint": {
      "comment": "配对 sheet：指纹核对提示",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gleiche Fingerabdruck steht in den MeshDrop-Einstellungen des anderen Geräts. Nur bei Übereinstimmung erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The peer sees the same fingerprint in MeshDrop settings. Only matching ones are allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma huella aparece en los ajustes de MeshDrop del otro dispositivo. Permite solo si coinciden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même empreinte figure dans les réglages MeshDrop de l’autre appareil. N’autorisez que si elle correspond."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のMeshDrop設定にも同じフィンガープリントが表示されます。一致する場合のみ許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방의 MeshDrop 설정에도 같은 지문이 표시됩니다. 일치할 때만 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对端 MeshDrop 设置里也能看到相同的指纹。两边一致才允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對端 MeshDrop 設置里也能看到相同的指紋。兩邊一致才允許。"
          }
        }
      }
    },
