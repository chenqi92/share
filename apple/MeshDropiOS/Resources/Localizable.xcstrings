    "onboarding.page3.body": {
      "comment": "Onboarding 第 3 页正文",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden zwischen Geräten verschlüsselt übertragen, ohne Umweg über die Cloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are encrypted in transit between devices, without going through the cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se transfieren cifrados entre dispositivos, sin pasar por la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont chiffrés entre les appareils, sans passer par le cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはクラウドを経由せず、デバイス間で暗号化して転送されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 클라우드를 거치지 않고 기기 간에 암호화되어 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在设备之间加密传输，不经过云端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在設備之間加密傳輸，不經過雲端。"
          }
        }
      }
    },
