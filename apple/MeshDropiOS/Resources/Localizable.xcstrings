    "settings.security.reset.detail": {
      "comment": "设置·安全：重置身份副文案",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Geräte behandeln dieses Gerät als neu und müssen erneut gekoppelt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peers will treat this device as new and must re-pair"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los otros dispositivos deberán volver a enlazarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres appareils devront le jumeler à nouveau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手からは新しいデバイスとして扱われ、再ペアリングが必要になります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방에게 새 기기로 인식되며 다시 페어링해야 합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对端会把本机视为新设备需重新配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對端會把本機視為新設備需重新配對"
          }
        }
      }
    },
