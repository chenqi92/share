{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover nearby MeshDrop devices and transfer content directly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于发现附近的 MeshDrop 设备并直接传输内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於探索附近的 MeshDrop 裝置並直接傳輸內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのMeshDropデバイスを検出し、コンテンツを直接転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 MeshDrop 기기를 검색하고 콘텐츠를 직접 전송합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecter les appareils MeshDrop à proximité et transférer directement du contenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshDrop-Geräte in der Nähe erkennen und Inhalte direkt übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectar dispositivos MeshDrop cercanos y transferir contenido directamente."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover nearby devices and transfer text, photos and files using Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于通过蓝牙发现附近设备并传输文字、图片和文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於透過藍牙探索附近裝置並傳輸文字、圖片和檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothで近くのデバイスを検出し、テキスト、写真、ファイルを転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth로 주변 기기를 검색하고 텍스트, 사진 및 파일을 전송합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecter les appareils à proximité et transférer textes, photos et fichiers par Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte in der Nähe finden und Texte, Fotos sowie Dateien per Bluetooth übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectar dispositivos cercanos y transferir texto, fotos y archivos por Bluetooth."
          }
        }
      }
    },
