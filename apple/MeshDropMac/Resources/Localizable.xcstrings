          }
        }
      }
    },
    "pairing.step2": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Ed25519-Fingerabdrücke vergleichen (8 Gruppen mit je 4 Zeichen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visually compare both Ed25519 fingerprints (4 chars × 8 groups)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara las huellas Ed25519 (8 grupos de 4 caracteres)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les empreintes Ed25519 (8 groupes de 4 caractères)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のEd25519指紋を比較してください（4文字 × 8組）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽 Ed25519 지문을 직접 비교하세요(4자 × 8그룹)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对比两端的 Ed25519 指纹（4 字符 × 8 组）目视一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對比兩端的 Ed25519 指紋（4 字符 × 8 組）目視一致"
          }
        }
      }
    },
    "pairing.step3": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf beiden Geräten „Erlauben und merken“ wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both tap \"Allow and remember\" to trust from now on"
          }
