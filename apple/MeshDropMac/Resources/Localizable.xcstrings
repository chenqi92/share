    "settings.security.resetIdentity.confirm.title": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zurücksetzen werden eine neue ID und neue Schlüssel erzeugt. Alle Geräte müssen erneut mit diesem Mac gekoppelt werden. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetting identity generates a new ID and key pair. Every device you've paired with will treat this Mac as a new device and need to pair again. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generarán un ID y unas claves nuevos. Todos los dispositivos deberán vincularse de nuevo con este Mac. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réinitialisation génère un nouvel identifiant et de nouvelles clés. Tous les appareils devront être jumelés à nouveau avec ce Mac. Continuer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDをリセットすると新しいIDと鍵が生成されます。ペアリング済みのデバイスでも、このMacとの再ペアリングが必要になります。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ID를 재설정하면 새 ID와 키 쌍이 생성됩니다. 페어링된 모든 기기에서 이 Mac을 새 기기로 인식하므로 다시 페어링해야 합니다. 계속할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置身份会生成新的 ID 与密钥对，所有已配对的对端会把本机视为新设备需要重新配对。继续？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置身份會生成新的 ID 與密鑰對，所有已配對的對端會把本機視為新設備需要重新配對。繼續？"
          }
        }
      }
    },
