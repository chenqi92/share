    "trust.empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine gekoppelten Geräte. Beim ersten Senden wird die Kopplung gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired devices yet. Sending your first thing to someone will trigger pairing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay dispositivos enlazados. El primer envío iniciará el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil jumelé. Le premier envoi déclenchera le jumelage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスはありません。初回の送信時にペアリングを行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기가 없습니다. 처음 전송할 때 페어링이 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已配对的设备。和别人互发第一份内容会触发配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有已配對的設備。和別人互發第一份內容會觸發配對。"
          }
        }
      }
    },
    "trust.intro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen mit diesem Mac gekoppelte Geräte. Vergleichen Sie vor dem Vertrauen die Fingerabdrücke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices paired with this Mac show up here. The fingerprint must match the other side by eye before you trust it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los dispositivos enlazados a este Mac. Compara las huellas antes de confiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils jumelés à ce Mac apparaissent ici. Comparez les empreintes avant de faire confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacとペアリングしたデバイスが表示されます。信頼する前に、双方のフィンガープリントが一致することを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac과 페어링된 기기가 표시됩니다. 신뢰하기 전에 양쪽 지문이 일치하는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对设备会在此显示。信任前，请确认两端显示的指纹一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已配對設備會在此顯示。信任前，請確認兩端顯示的指紋一致。"
          }
        }
      }
    },
