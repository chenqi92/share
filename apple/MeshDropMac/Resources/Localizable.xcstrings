        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa «Permitir y recordar» en ambos dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Autoriser et mémoriser » des deux côtés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方で「許可して記憶」を押すと今後も信頼されます"
          }
