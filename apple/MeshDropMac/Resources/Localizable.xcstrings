    "onboarding.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, Bilder oder Textnotizen auf ein Gerätesymbol ziehen. Das andere Gerät erhält sofort eine Empfangsanfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any file, image, or text note. Drag it onto a device avatar on the Discovery radar and the other side gets an accept request instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un archivo, imagen o nota al avatar de un dispositivo. El otro dispositivo recibirá una solicitud al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez un fichier, une image ou une note sur l’avatar d’un appareil pour lui envoyer une demande de réception."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、画像、テキストメモを近くのデバイスのアイコンにドラッグすると、相手に受信リクエストが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일, 이미지, 텍스트 메모를 근처 기기 아바타에 끌어놓으면 상대에게 수신 요청이 전달됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何文件、图片、文字便签。拖到附近设备的头像，对方即可收到接收请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何文件、圖片、文字便簽。拖到附近設備的頭像，對方即可收到接收請求。"
          }
        }
      }
    },
