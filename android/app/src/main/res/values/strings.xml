    <!-- ========== Onboarding ========== -->
    <string name="onboarding.step1_tag">STEP 1 · DISCOVERY</string>
    <string name="onboarding.step1_title">雷达式发现</string>
    <string name="onboarding.step1_body">本机会自动注册到局域网，扫描同 Wi-Fi 下的其他 MeshDrop 设备。雷达图实时显示 RTT 和方位。</string>
    <string name="onboarding.step2_tag">STEP 2 · DRAG-TO-SEND</string>
    <string name="onboarding.step2_title">拖即发送</string>
    <string name="onboarding.step2_body">把文件拖到设备 row 上，或长按选多台。也支持 Android 原生 Share Intent。</string>
    <string name="onboarding.step3_tag">STEP 3 · PAIRING</string>
    <string name="onboarding.step3_title">配对与指纹信任</string>
    <string name="onboarding.step3_body">身份为 Ed25519 长期密钥，指纹是公钥的 SHA-256 前缀。首次连接弹 6 字符确认（TOFU），配对后双方互信指纹。v0.1 局域网传输为明文 TCP，加密待后续版本。</string>
    <string name="onboarding.step4_tag">STEP 4 · SHORTCUTS</string>
    <string name="onboarding.step4_title">通知 / 后台 / 系统分享</string>
    <string name="onboarding.step4_body">大文件用 Foreground Service 保活，incoming 弹 heads-up 通知，三键操作。</string>
