    <!-- ========== Onboarding ========== -->
    <string name="onboarding.step1_tag">STEP 1 · DISCOVERY</string>
    <string name="onboarding.step1_title">Radar discovery</string>
    <string name="onboarding.step1_body">This device registers on the local network and scans for other MeshDrop devices on the same Wi-Fi. The radar shows RTT and bearing in real time.</string>
    <string name="onboarding.step2_tag">STEP 2 · DRAG-TO-SEND</string>
    <string name="onboarding.step2_title">Drag to send</string>
    <string name="onboarding.step2_body">Drag a file onto a device row, or long-press to pick several. The native Android Share Intent is supported too.</string>
    <string name="onboarding.step3_tag">STEP 3 · PAIRING</string>
    <string name="onboarding.step3_title">Pairing and fingerprint trust</string>
    <string name="onboarding.step3_body">Identity is a long-lived Ed25519 key; the fingerprint is the SHA-256 prefix of the public key. The first connection prompts a 6-character confirmation (TOFU); after pairing both sides trust each other\'s fingerprint. In v0.1 LAN transfer is plaintext TCP; encryption comes in a later version.</string>
    <string name="onboarding.step4_tag">STEP 4 · SHORTCUTS</string>
    <string name="onboarding.step4_title">Notifications / background / system share</string>
    <string name="onboarding.step4_body">Large files stay alive via a Foreground Service, incoming items raise a heads-up notification with three quick actions.</string>
