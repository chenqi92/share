<?xml version="1.0" encoding="utf-8"?>
<!-- 108x108 adaptive icon foreground · 重叠两圆环 + 中央 lime 实心圆点 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 安全区位于中心 72×72 · 中心 (54,54)。把 viewBox 24×24 的 mark 放大 ×3 居中 -->
    <!-- 左圆 cx=9*3+18=45, cy=54, r=6.5*3=19.5 -->
    <path
        android:strokeColor="#0A0A0A"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M 45,54 m -19.5,0 a 19.5,19.5 0 1,0 39,0 a 19.5,19.5 0 1,0 -39,0" />
    <!-- 右圆 cx=15*3+18=63, cy=54, r=19.5 -->
    <path
        android:strokeColor="#0A0A0A"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M 63,54 m -19.5,0 a 19.5,19.5 0 1,0 39,0 a 19.5,19.5 0 1,0 -39,0" />
    <!-- 中心 lime 圆点 r=1.8*3=5.4 -->
    <path
        android:fillColor="#DDF94B"
        android:pathData="M 54,54 m -5.4,0 a 5.4,5.4 0 1,0 10.8,0 a 5.4,5.4 0 1,0 -10.8,0" />
</vector>
